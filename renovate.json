{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)",
    ":dependencyDashboard",
    "schedule:weekly"
  ],
  "timezone": "Asia/Makassar",
  "schedule": [
    "before 5am on monday"
  ],
  "labels": [
    "dependencies",
    "renovate"
  ],
  "assignees": [
    "AmitabhainArunachala"
  ],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "branchPrefix": "renovate/",
  "commitMessagePrefix": "chore(deps):",
  "rebaseWhen": "auto",
  "platformAutomerge": false,
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 5am on monday"
    ]
  },
  "ignorePaths": [
    "migration_delta/**",
    "dharma_swarm_old/**",
    ".dharma_psmv_hyperfile_branch*/**"
  ],
  "pip_requirements": {
    "fileMatch": [
      "(^|/)requirements[\\w-]*\\.txt$",
      "(^|/)requirements-dev\\.txt$",
      "(^|/)requirements-ginko\\.txt$"
    ]
  },
  "pip_setup": {
    "fileMatch": [
      "(^|/)setup\\.py$"
    ]
  },
  "pep621": {
    "fileMatch": [
      "(^|/)pyproject\\.toml$"
    ]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security",
      "renovate"
    ],
    "schedule": [
      "at any time"
    ]
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Group testing toolchain",
      "matchPackagePatterns": [
        "^pytest",
        "^hypothesis"
      ],
      "groupName": "testing toolchain",
      "schedule": [
        "before 5am on monday"
      ]
    },
    {
      "description": "Group LLM provider SDKs separately for careful review",
      "matchPackagePatterns": [
        "^anthropic",
        "^openai",
        "^ollama",
        "^litellm"
      ],
      "groupName": "llm provider SDKs",
      "minimumReleaseAge": "3 days",
      "automerge": false
    },
    {
      "description": "Pin major bumps for ML stable surface",
      "matchPackageNames": [
        "torch",
        "transformers",
        "accelerate",
        "transformer-lens",
        "sae-lens",
        "nnsight"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Pin major bumps for FastAPI / Pydantic stack",
      "matchPackageNames": [
        "fastapi",
        "pydantic",
        "uvicorn"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "Auto-merge dev-only patch bumps",
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": false
    },
    {
      "description": "GitHub Actions: pin to commit SHAs but show tag in description",
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true,
      "schedule": [
        "before 5am on monday"
      ]
    }
  ],
  "dependencyDashboardTitle": "Renovate dependency dashboard",
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "configMigration": true
}
