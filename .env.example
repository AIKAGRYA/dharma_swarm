# ============================================================
# DHARMA SWARM — Environment Configuration
# Copy to .env and fill in your values.
# ============================================================

# ── LLM Provider Lanes (fill ANY ONE live lane to go live) ──
# Canonical registry: dharma_swarm/api_keys.py (PROVIDER_API_KEY_ENV_KEYS).
# The routing system (model_hierarchy / runtime_provider) uses whichever
# lanes have real keys; blank = lane disabled. Keys stay BLANK here —
# placeholder-looking values (sk-...) make fake keys look configured.
# Parity with docker-compose.yml is enforced by
# tests/test_provider_env_parity.py.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=
OLLAMA_API_KEY=
GROQ_API_KEY=                         # May 403 from some networks (Bali)
CEREBRAS_API_KEY=
SILICONFLOW_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
GOOGLE_AI_API_KEY=                    # alias: GEMINI_API_KEY
SAMBANOVA_API_KEY=
MISTRAL_API_KEY=
CHUTES_API_KEY=
ZHIPU_API_KEY=                        # z.ai / Zhipu GLM; aliases: GLM_API_KEY, ZAI_API_KEY, ZHIPUAI_API_KEY, BIGMODEL_API_KEY
KIMI_API_KEY=                         # Kimi Code membership lane (alias: MOONSHOT_KIMI_API_KEY)
MOONSHOT_API_KEY=                     # Moonshot Platform pay-as-you-go (distinct from KIMI_API_KEY)
OLLAMA_BASE_URL=http://localhost:11434 # Local Ollama instance
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Evolution & Autonomy (PR-001 fail-closed) ────────────────
# The SAFE state requires NO configuration. These example values keep live
# mutation IMPOSSIBLE. Real mutation additionally requires a marked scratch
# worktree AND a valid live-mutation lease — env flags alone can never enable it.
DHARMA_EVOLUTION_SHADOW=1             # 1=shadow/dry-run (never mutate source); NEVER ship 0
DGC_AUTONOMY_LEVEL=1                  # 0=passive, 1=suggest; NEVER default to 2
DHARMA_SELF_IMPROVE=0                 # 0=disabled (not auto-enabled by autonomy)
DHARMA_ALLOW_LIVE_MUTATION=0         # 0=live mutation forbidden (requires lease anyway)
DHARMA_ALLOW_CUSTODIAN_MERGE=0       # 0=scheduled merge-to-main stays dry-run only
# DHARMA_EVOLUTION_WORKTREE_ROOT=/evolution_worktrees   # scratch worktree root
# DHARMA_MODEL_BUDGET_USD=0           # >0 to open the model-spend budget gate
# DHARMA_EVAL_MOUNT=/path/to/dharma_eval  # read-only protected evaluator mount

# ── Observability (optional) ─────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Guardian Crew ────────────────────────────────────────────
GUARDIAN_INTERVAL_SECONDS=14400       # 4 hours (default)

# ── Knowledge & Memory ───────────────────────────────────────
ENABLE_KNOWLEDGE_EXTRACTION=true
DHARMA_STATE_DIR=~/.dharma            # Where all state is written

# ── Ginko Trading Bridge (optional) ─────────────────────────
GINKO_WEBHOOK_URL=...
GINKO_DAILY_BUDGET=100
GINKO_WEEKLY_BUDGET=500

# ── Feature Flags ────────────────────────────────────────────
DHARMA_FAST_BOOT=false
ENABLE_EFE_ROUTING=true
ENABLE_FITNESS_ROUTING=true

# ── VPS organism host (docs/ops/RUNBOOK.md §3e; compose --profile vps) ──
# Litestream off-host replication of ~/.dharma/state/runtime.db (optional
# but recommended on the VPS). Any S3-compatible target works.
LITESTREAM_REPLICA_URL=               # e.g. s3://my-bucket/dharma/runtime.db
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
# AGNI NATS hub (outbound; no local broker needed) — see RUNBOOK §3e
DEVIN_NATS_URL=
DEVIN_NATS_USER=
DEVIN_NATS_PW=
