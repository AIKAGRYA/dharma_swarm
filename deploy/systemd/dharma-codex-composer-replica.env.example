# Non-secret identity and topology. Copy to
# /etc/dharma/codex-composer-replica.env with mode 0600 and add the scoped
# password only to /etc/dharma/codex-composer-nats.secret; never commit either
# populated host file.
CODEX_COMPOSER_INSTANCE_ID=meghadharma
CODEX_COMPOSER_REPLICA_ROLE=orientation_primary
CODEX_COMPOSER_NATS_URL=nats://127.0.0.1:4222
CODEX_COMPOSER_NATS_USER=codex_composer_primary
CODEX_COMPOSER_CARD_PATH=/opt/dharma-codex-composer/codex_composer.agent-card.json
CODEX_COMPOSER_CARD_SHA256=REPLACE_WITH_PINNED_SHA256
CODEX_COMPOSER_MEMORY_PATH=/opt/dharma-codex-composer/codex_composer.memory.json
CODEX_COMPOSER_MEMORY_SHA256=REPLACE_WITH_PINNED_SHA256
CODEX_COMPOSER_WORKSPACE=/opt/dharma-codex-composer/repo
CODEX_COMPOSER_CODEX_BIN=codex
CODEX_COMPOSER_SEAT_USER=codex-composer-seat
CODEX_COMPOSER_TMUX_SESSION=codex_composer
CODEX_COMPOSER_STATE_DIR=/var/lib/dharma-codex-composer
CODEX_COMPOSER_HEARTBEAT_INTERVAL_SECONDS=20
CODEX_COMPOSER_PUBLISH_CANONICAL_PRESENCE=true

# Remote instances use wss://MEGHADHARMA:9443 and their exact principal:
# agni -> codex_composer_agni
# rushabdev -> codex_composer_rushabdev
#
# Separate root-owned /etc/dharma/codex-composer-nats.secret:
# CODEX_COMPOSER_NATS_PASSWORD=REPLACE_LOCALLY
