[Unit]
Description=Private tailnet route to SADHANA loopback dashboard
After=tailscaled.service dharma-sadhana-dashboard.service dharma-sadhana-control-directories.service
Requires=dharma-sadhana-dashboard.service dharma-sadhana-control-directories.service
PartOf=dharma-sadhana.target
ConditionPathExists=/etc/dharma-sadhana/writer-enabled
ConditionPathExists=!/etc/dharma-sadhana/receipts/control/emergency/emergency-stopped
ConditionDirectoryNotEmpty=!/var/lib/dharma-sadhana/emergency-inflight

[Service]
Type=oneshot
ExecStartPre=/opt/dharma-sadhana/releases/@RELEASE_SHA@/.venv/bin/python /opt/dharma-sadhana/releases/@RELEASE_SHA@/scripts/runtime/sadhana_release.py guard-start --role writer
ExecStart=/opt/dharma-sadhana/releases/@RELEASE_SHA@/.venv/bin/python /opt/dharma-sadhana/releases/@RELEASE_SHA@/scripts/runtime/sadhana_release.py tailscale-start --role writer --release-sha @RELEASE_SHA@
ExecStop=/opt/dharma-sadhana/releases/@RELEASE_SHA@/.venv/bin/python /opt/dharma-sadhana/releases/@RELEASE_SHA@/scripts/runtime/sadhana_release.py tailscale-stop --role writer --release-sha @RELEASE_SHA@
RemainAfterExit=yes
TimeoutStartSec=30s
TimeoutStopSec=30s
NoNewPrivileges=true
CapabilityBoundingSet=
KeyringMode=private
LockPersonality=true
PrivateDevices=true
PrivateIPC=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/etc/dharma-sadhana/receipts/preactivation
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=dharma-sadhana.target
