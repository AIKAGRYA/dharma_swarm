[Unit]
Description=Validate and immutably finalize one-way SADHANA standby uploads
PartOf=dharma-sadhana-standby.target
ConditionPathExists=!/etc/dharma-sadhana/receipts/standby/deadline-stopped.v1.json

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/
ExecStartPre=/opt/dharma-sadhana/releases/@RELEASE_SHA@/.venv/bin/python /opt/dharma-sadhana/releases/@RELEASE_SHA@/scripts/runtime/sadhana_release.py guard-start --role standby
ExecStart=/opt/dharma-sadhana/releases/@RELEASE_SHA@/.venv/bin/python /opt/dharma-sadhana/releases/@RELEASE_SHA@/scripts/runtime/sadhana_snapshot.py finalize-standby --mission-id sadhana-10-20260823 --role standby --release-sha @RELEASE_SHA@
TimeoutStartSec=240s
NoNewPrivileges=true
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
AmbientCapabilities=
KeyringMode=private
LockPersonality=true
PrivateDevices=true
PrivateIPC=true
PrivateNetwork=true
PrivateTmp=true
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RemoveIPC=true
ReadOnlyPaths=/opt/dharma-sadhana/releases/@RELEASE_SHA@
ReadWritePaths=/var/lib/dharma-sadhana/snapshot-incoming/uploads /var/lib/dharma-sadhana/snapshot-incoming/acks /var/lib/dharma-sadhana/snapshot-receiver-claims /var/lib/dharma-sadhana/snapshots /var/lib/dharma-sadhana/snapshot-quarantine /var/lib/dharma-sadhana/snapshot-receipts
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
IPAddressDeny=any
UMask=0077

[Install]
WantedBy=dharma-sadhana-standby.target
