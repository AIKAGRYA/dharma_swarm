[Unit]
Description=Prepare the sealed SADHANA runtime without dispatch authority
Before=dharma-sadhana.target dharma-sadhana-dispatch.target
ConditionPathExists=!/etc/dharma-sadhana/writer-enabled
ConditionPathExists=!/etc/dharma-sadhana/receipts/preactivation/dispatch-enabled.v1.json
ConditionPathExists=!/etc/dharma-sadhana/receipts/runtime/sadhana-10-20260823/runtime-binding-activation.v2.json
ConditionPathExists=/var/lib/dharma-sadhana/state/release-admission/staged-release-admission.v1.json
ConditionPathExists=/etc/dharma-sadhana/receipts/releases/@RELEASE_SHA@/runtime-prep.env

[Service]
Type=oneshot
User=dharma-sadhana
Group=dharma-sadhana
EnvironmentFile=/etc/dharma-sadhana/receipts/releases/@RELEASE_SHA@/runtime-prep.env
WorkingDirectory=/var/lib/dharma-sadhana/state
ExecStart=/opt/dharma-sadhana/releases/@RELEASE_SHA@/.venv/bin/python /opt/dharma-sadhana/releases/@RELEASE_SHA@/scripts/runtime/sadhana_prepare_runtime.py --release-root ${SADHANA_PREP_RELEASE_ROOT} --release-sha ${SADHANA_PREP_RELEASE_SHA} --release-input-set-digest ${SADHANA_PREP_RELEASE_INPUT_SET_DIGEST} --release-admission-receipt ${SADHANA_PREP_RELEASE_ADMISSION_RECEIPT} --contracts ${SADHANA_PREP_CONTRACTS} --observed-source ${SADHANA_PREP_OBSERVED_SOURCE} --roster ${SADHANA_PREP_ROSTER} --roster-sha256 ${SADHANA_PREP_ROSTER_SHA256} --objective-sha256 ${SADHANA_PREP_OBJECTIVE_SHA256} --state-dir ${SADHANA_PREP_STATE_DIR} --manifest-staging-root ${SADHANA_PREP_MANIFEST_STAGING_ROOT} --operator-id ${SADHANA_PREP_OPERATOR_ID} --verifier-seat ${SADHANA_PREP_VERIFIER_SEAT} --evaluator-path ${SADHANA_PREP_EVALUATOR_PATH} --evaluator-sha256 ${SADHANA_PREP_EVALUATOR_SHA256} --policy-path ${SADHANA_PREP_POLICY_PATH} --policy-sha256 ${SADHANA_PREP_POLICY_SHA256} --operator-control-semantics-sha256 ${SADHANA_PREP_OPERATOR_CONTROL_SEMANTICS_SHA256} --operator-control-authority-binding-sha256 ${SADHANA_PREP_OPERATOR_CONTROL_AUTHORITY_BINDING_SHA256} --deployment-authority-topology-sha256 ${SADHANA_PREP_DEPLOYMENT_AUTHORITY_TOPOLOGY_SHA256} --deployment-authority-credential-clarification-sha256 ${SADHANA_PREP_DEPLOYMENT_AUTHORITY_CREDENTIAL_CLARIFICATION_SHA256} --max-dispatch-per-cycle ${SADHANA_PREP_MAX_DISPATCH_PER_CYCLE} --cycle-interval-seconds ${SADHANA_PREP_CYCLE_INTERVAL_SECONDS} --freshness-seconds ${SADHANA_PREP_FRESHNESS_SECONDS}
RemainAfterExit=yes
TimeoutStartSec=300s
RuntimeMaxSec=300s
TasksMax=64
MemoryMax=2G
NoNewPrivileges=true
CapabilityBoundingSet=
KeyringMode=private
LockPersonality=true
PrivateDevices=true
PrivateIPC=true
PrivateNetwork=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RemoveIPC=true
ReadOnlyPaths=/opt/dharma-sadhana/releases/@RELEASE_SHA@ /etc/dharma-sadhana/inputs /var/lib/dharma-sadhana/state/release-admission
ReadWritePaths=/var/lib/dharma-sadhana/state
InaccessiblePaths=/etc/dharma-sadhana/credentials /etc/dharma-sadhana/verifier.env /run/credentials /run/dharma-sadhana/control /run/dharma-sadhana/oracle
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=~ptrace process_vm_readv process_vm_writev
IPAddressDeny=any
UMask=0077
