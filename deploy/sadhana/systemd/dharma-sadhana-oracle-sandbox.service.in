[Unit]
Description=Execute admitted SADHANA held-out oracle requests in isolation
Requires=dharma-sadhana-oracle-directories.service dharma-sadhana-oracle-sandbox-probe.service
After=dharma-sadhana-oracle-directories.service dharma-sadhana-oracle-sandbox-probe.service
PartOf=dharma-sadhana.target
ConditionPathExists=/etc/dharma-sadhana/writer-enabled
ConditionPathExists=!/etc/dharma-sadhana/receipts/control/emergency/emergency-stopped
ConditionDirectoryNotEmpty=!/var/lib/dharma-sadhana/emergency-inflight

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/
ExecStartPre=/opt/dharma-sadhana/releases/@RELEASE_SHA@/.venv/bin/python /opt/dharma-sadhana/releases/@RELEASE_SHA@/scripts/runtime/sadhana_release.py guard-start --role writer
ExecStart=/opt/dharma-sadhana/releases/@RELEASE_SHA@/.venv/bin/python /opt/dharma-sadhana/releases/@RELEASE_SHA@/scripts/runtime/sadhana_oracle_sandbox.py reconcile --release-sha @RELEASE_SHA@
TimeoutStartSec=90s
RuntimeMaxSec=90s
KillMode=control-group
TasksMax=32
MemoryMax=768M
NoNewPrivileges=true
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETGID CAP_SETUID
AmbientCapabilities=
KeyringMode=private
LockPersonality=true
PrivateDevices=true
PrivateIPC=true
PrivateNetwork=true
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RemoveIPC=true
InaccessiblePaths=/var/lib/dharma-sadhana/state /var/lib/dharma-sadhana/workspace /var/lib/dharma-sadhana/leases /var/lib/dharma-sadhana/projection-source /var/lib/dharma-sadhana/api-state /run/dharma-sadhana/control /etc/dharma-sadhana/credentials /etc/dharma-sadhana/verifier.env /etc/dharma-sadhana/supervisor.env /etc/dharma-sadhana/control.env /etc/dharma-sadhana/dashboard.env /etc/dharma-sadhana/replication.env
ReadOnlyPaths=/opt/dharma-sadhana/releases/@RELEASE_SHA@ /etc/systemd/system/dharma-sadhana-oracle-sandbox.service /etc/dharma-sadhana/inputs/runtime/sadhana-10-20260823 /run/dharma-sadhana/oracle/requests /var/lib/dharma-sadhana/oracle-inputs
ReadWritePaths=/run/dharma-sadhana/oracle/terminals /var/lib/dharma-sadhana/oracle-claims /var/lib/dharma-sadhana/oracle-runs /var/lib/dharma-sadhana/oracle-quarantine /etc/dharma-sadhana/receipts/oracle
TemporaryFileSystem=/tmp:ro /var/tmp:ro /dev/shm:ro
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=~ptrace process_vm_readv process_vm_writev socket socketpair connect bind listen accept accept4 sendto sendmsg sendmmsg recvfrom recvmsg recvmmsg shutdown setsockopt
IPAddressDeny=any
UMask=0077
