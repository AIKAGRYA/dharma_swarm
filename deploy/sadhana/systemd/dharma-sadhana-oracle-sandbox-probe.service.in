[Unit]
Description=Prove the exact SADHANA held-out oracle sandbox before dispatch
Requires=dharma-sadhana-oracle-directories.service
After=dharma-sadhana-oracle-directories.service
Before=dharma-sadhana-supervisor.service dharma-sadhana-oracle-sandbox.service
PartOf=dharma-sadhana.target
ConditionPathExists=/etc/dharma-sadhana/writer-enabled
ConditionPathExists=!/etc/dharma-sadhana/receipts/control/emergency/emergency-stopped
ConditionDirectoryNotEmpty=!/var/lib/dharma-sadhana/emergency-inflight

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/
ExecStartPre=/opt/dharma-sadhana/releases/@RELEASE_SHA@/.venv/bin/python /opt/dharma-sadhana/releases/@RELEASE_SHA@/scripts/runtime/sadhana_release.py guard-start --role writer
ExecStart=/opt/dharma-sadhana/releases/@RELEASE_SHA@/.venv/bin/python /opt/dharma-sadhana/releases/@RELEASE_SHA@/scripts/runtime/sadhana_oracle_sandbox.py probe --release-sha @RELEASE_SHA@
RemainAfterExit=true
TimeoutStartSec=30s
RuntimeMaxSec=30s
TasksMax=8
MemoryMax=256M
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
KeyringMode=private
LockPersonality=true
PrivateDevices=true
PrivateIPC=true
PrivateNetwork=true
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RemoveIPC=true
InaccessiblePaths=/var/lib/dharma-sadhana/state /var/lib/dharma-sadhana/workspace /var/lib/dharma-sadhana/leases /run/dharma-sadhana/control /etc/dharma-sadhana/credentials /etc/dharma-sadhana/verifier.env
ReadOnlyPaths=/opt/dharma-sadhana/releases/@RELEASE_SHA@ /etc/systemd/system/dharma-sadhana-oracle-sandbox.service
ReadWritePaths=/var/lib/dharma-sadhana/oracle-runs /etc/dharma-sadhana/receipts/oracle
TemporaryFileSystem=/tmp:ro /var/tmp:ro /dev/shm:ro
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=~ptrace process_vm_readv process_vm_writev socket socketpair connect bind listen accept accept4 sendto sendmsg sendmmsg recvfrom recvmsg recvmmsg shutdown setsockopt
IPAddressDeny=any
UMask=0077
