[Unit]
Description=SADHANA fenced append-only standby receiver
ConditionPathExists=!/etc/dharma-sadhana/receipts/standby/deadline-stopped.v1.json
Requires=dharma-sadhana-standby-snapshot-receiver.path dharma-sadhana-standby-snapshot-receiver.timer
After=network-online.target

[Install]
WantedBy=multi-user.target
