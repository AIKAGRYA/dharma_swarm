[Unit]
Description=Allowlisted VPS memory pressure guard
Documentation=file:/usr/local/share/doc/vps-resource-guard/README.md
After=local-fs.target docker.service
Wants=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=exec
ExecStart=/usr/local/lib/vps-resource-guard/vps_resource_guard.py --config /etc/vps-resource-guard/config.toml
Restart=always
RestartSec=5s
TimeoutStopSec=10s
OOMScoreAdjust=-900
MemoryAccounting=true
MemoryHigh=192M
MemoryMax=256M
UMask=0077
Environment=DOCKER_HOST=unix:///run/docker.sock
Environment=DOCKER_CONFIG=/run/vps-resource-guard
Environment=XDG_RUNTIME_DIR=/run/user/0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/0/bus

User=root
Group=root
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
# Hide home-directory data while retaining /run/user/0/bus for the closed
# systemd-user allowlist.
InaccessiblePaths=/home /root
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
StateDirectory=vps-resource-guard
StateDirectoryMode=0700
LogsDirectory=vps-resource-guard
LogsDirectoryMode=0700
RuntimeDirectory=vps-resource-guard
RuntimeDirectoryMode=0700
ReadWritePaths=/var/lib/vps-resource-guard /var/log/vps-resource-guard

[Install]
WantedBy=multi-user.target
