  "complete01_promotion_rule": {
    "complete_true_requires": [
      "all four installed distribution versions exactly match target_distributions",
      "all four RECORD and METADATA digests exactly match target_distributions",
      "the discovered non-private RECORD-owned module set exactly equals target_modules",
      "every target module imports successfully in a bounded isolated process",
      "every observed surface is bound to its exact module route or exact pre-frozen module exclusion",
      "every route names only existing V2 row ids and exact V2 facet ids",
      "every V2 facet has at least one row_facet_routes reference surface",
      "observed_surface_count equals mapped_surface_count plus excluded_surface_count",
      "uncovered_surface_ids and import_errors are empty",
      "the stable builder and independent judge digests bind the complete manifest and route digests"
    ],
    "fail_closed_on": [
      "new, missing, duplicate, or ambiguously owned module",
      "new or unmapped public export or declared class member",
      "wildcard or fallback route",
      "inline implementation-authored exclusion",
      "route to an unknown row or facet",
      "reverse-uncovered frozen facet",
      "version, RECORD, METADATA, source digest, or import drift"
    ],
    "score_effect": "none"
  },
  "required_controls": [
    "synthetic unlisted module, export, and direct class member each make COMPLETE01 false",
    "missing module, import error, access error, signature error, and timeout each make COMPLETE01 false",
    "version, RECORD, and METADATA drift each make COMPLETE01 false",
    "wildcard route, unknown row/facet route, and implementation-authored exclusion each fail validation",
    "reverse-uncovered V2 facet fails validation",
    "an importable but behaviorally broken Dharma engine scores 0.00",
    "identical exceptions from both differential arms never count as parity",
    "clone-owned APP equality cannot promote neutral-engine integration",
    "missing, zero, NaN, or fabricated PERF samples cannot promote a PERF facet"
  ],
  "implementation_sequence": [
    "merge this freeze without implementation or results",
    "implement V3 custody and controls in a separate exact-main packet",
    "emit the builder result from committed source",
    "run an independent zero-context AI judge and record the exact reconciliation receipt",
    "source-ratify only the exact reviewed judge attestation digest",
    "replay the final check on the exact candidate head"
  ],
  "frozen_before_results": {
    "contains_implementation": false,
    "contains_execution_result": false,
    "contains_score": false,
    "contains_receipt": false,
    "merge_required_before_consumption": true
  }
}
