FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl git build-essential \
    && rm -rf /var/lib/apt/lists/*

# Python deps first (cache layer)
COPY pyproject.toml README.md ./
COPY dharma_swarm/__init__.py dharma_swarm/
# WP-0C2 (TIT-003): dependency-install failure fails the image build. The
# previous fallback chain (2>/dev/null || ... || true) could boot the
# Go-integrated daemon on an invalid Python environment.
RUN pip install --no-cache-dir -e ".[dev]"

# Full source
COPY dharma_swarm/ /app/dharma_swarm/
COPY scripts/runtime/dharma_swarm_container_runner.sh /usr/local/bin/dharma-swarm-container-runner

# Seal the exact source tree that the image will execute. Runtime admission
# treats this as container-image provenance, never as proof of canonical Git.
RUN set -eu; \
    test -z "$(find /app/dharma_swarm -type l -print -quit)"; \
    (cd /app/dharma_swarm && \
      find . -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum) \
      > /app/.dharma-runtime-source.sha256; \
    chmod 0444 /app/.dharma-runtime-source.sha256; \
    chmod 0555 /usr/local/bin/dharma-swarm-container-runner

# State directory
RUN mkdir -p /root/.dharma/logs \
             /root/.dharma/evolution \
             /root/.dharma/stigmergy \
             /root/.dharma/telos \
             /root/.dharma/memory \
             /root/.dharma/meta \
             /root/.dharma/guardian \
             /root/.dharma/sub_swarms \
             /root/.dharma/shared \
             /root/.dharma/artifacts

# Health API port
EXPOSE 7433

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=60s \
    CMD curl -f http://localhost:7433/health || exit 1

# Keep the provenance boundary in force even when an operator supplies
# container arguments such as --verify-only.
ENTRYPOINT ["/usr/local/bin/dharma-swarm-container-runner"]
