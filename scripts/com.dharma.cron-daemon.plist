<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dharma.cron-daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>cd /Users/dhyana/dharma_swarm || exit 1; set -a; source /Users/dhyana/.dharma/agent_keys.env; source /Users/dhyana/dharma_swarm/.env 2&gt;/dev/null; set +a; unset GITHUB_TOKEN; exec env PYTHONPATH=/Users/dhyana/dharma_swarm TINY_ROUTER_BACKEND=heuristic ./.venv/bin/python -m dharma_swarm.dgc_cli cron daemon</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>~/.dharma/logs/cron-daemon.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>~/.dharma/logs/cron-daemon.stderr.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/dhyana/dharma_swarm</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/dhyana/.npm-global/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONPATH</key>
        <string>/Users/dhyana/dharma_swarm</string>
        <key>DHARMA_SPINE_DISPATCH</key>
        <string>1</string>
    </dict>
</dict>
</plist>
