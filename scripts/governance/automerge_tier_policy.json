{
  "schema": "dharma.automerge_tier_policy.v2",
  "ruling": "DOOR = AUTO_WITH_DECORRELATED_REVIEW (operator, 2026-07-29); TIER2 REPEAL = DECORRELATED_REVIEW_PLUS_REVERSIBILITY (operator, 2026-07-30)",
  "ruling_record": "docs/ops/OPERATOR_RULING_2026-07-30_SARATHI_AUTONOMY_CEILING.md",
  "prior_ruling_record": "docs/ops/OPERATOR_RULING_2026-07-29_AUTO_WITH_DECORRELATED_REVIEW.md",
  "confirmation_token_prefix": "automerge-policy-pass-",
  "rate_limit_automerges_per_day": 20,
  "autonomy_dial": {
    "env": "DGC_SARATHI_AUTONOMY",
    "levels": ["shadow", "propose", "dispatch", "full"],
    "default": "propose",
    "invalid_value_behavior": "shadow",
    "module": "dharma_swarm/operator_core/autonomy_dial.py"
  },
  "reversibility_floor": {
    "description": "Every unattended-lane PR at every tier: classify_action(pr_title, operator_reachable=False) must not classify OPERATOR_ONLY (NEVER_AUTO denylist and CRITICAL-risk vocabulary are the hard floor and do not move). Tier2 additionally requires every hit referee path clear of NEVER_AUTO substrings.",
    "module": "dharma_swarm/operator_core/reversibility_gate.py"
  },
  "reviewer_families": {
    "chatgpt-codex-connector[bot]": "openai",
    "copilot-pull-request-reviewer[bot]": "github-copilot"
  },
  "author_families": {
    "devin-ai-integration[bot]": "cognition",
    "github-actions[bot]": "automation",
    "Copilot": "github-copilot"
  },
  "tiers": {
    "tier0": {
      "description": "docs/markdown-only changes (doc_only_paths). The ruling's tier-0 also names test additions; until an additions-only classifier exists they deliberately ride tier1 (stricter: 2 reviews) rather than risk misclassifying test edits as tier0",
      "max_diff_lines": 300,
      "required_decorrelated_reviews": 1,
      "doc_only_paths": ["docs/", "*.md"]
    },
    "tier1": {
      "description": "source code, refactors, dependency bumps, lane outputs",
      "max_diff_lines": 600,
      "required_decorrelated_reviews": 2,
      "test_deletion_needs_named_signoff": true
    },
    "tier2": {
      "description": "referee layer — 2026-07-30 repeal of the 2026-07-29 'operator hand-merge FOREVER' clause: unattended merge is admissible when (decorrelated_reviews >= 2) AND (the reversibility gate admits the merge intent) AND (no NEVER_AUTO hit on title or referee path). The never-auto / irreversible / illegal floor stays operator-only and does not move.",
      "merge": "auto_with_decorrelated_review_and_reversibility",
      "max_diff_lines": 400,
      "required_decorrelated_reviews": 2,
      "test_deletion_needs_named_signoff": true,
      "paths": [
        ".github/workflows/**",
        "scripts/governance/automerge_tier_policy.json",
        "scripts/governance/check_automerge_tier_policy.py",
        "scripts/governance/ci_parity_manifest.json",
        "scripts/governance/check_ci_parity.py",
        "scripts/governance/check_pr_coherence_delta.py",
        "scripts/docops/check_docops_integrity.py",
        "scripts/governance/hygiene/check_hygiene_integrity.py",
        "scripts/governance/check_track_status.py",
        "scripts/governance/render_active_track_includes.py",
        "docs/governance/CI_TRUTH_CONTRACT.json",
        "scripts/runtime/ci_truth.py",
        "scripts/runtime/pr_merge_control.py",
        "scripts/runtime/merge_master_mike_daemon.py",
        "docs/governance/MMM_CHARTER.md",
        "docs/ops/loop_control/**",
        "docs/ops/OPERATOR_RULING_2026-07-29_AUTO_WITH_DECORRELATED_REVIEW.md",
        "docs/ops/OPERATOR_RULING_2026-07-30_SARATHI_AUTONOMY_CEILING.md",
        "dharma_swarm/forge_v1/forge_v2/**",
        "dharma_swarm/evolution_safety.py",
        "dharma_swarm/dharma_kernel.py",
        "dharma_swarm/telos_gates.py",
        "dharma_swarm/operator_core/reversibility_gate.py",
        "dharma_swarm/operator_core/autonomy_dial.py",
        "dharma_swarm/risk_patterns.py",
        "dharma_swarm/holon_system/observability/proof_gates.py",
        "docs/sarathi_apex_build/06_PROOF_GATES.md",
        "dharma_swarm/revenue/**",
        "dharma_swarm/a2a/**",
        "docs/governance/ACTIVE_TRACK.yaml",
        ".github/CODEOWNERS"
      ]
    }
  }
}
