{
  "schema": "dharma.automerge_tier_policy.v3",
  "ruling": "SAFE_P0 = DOCS_LOW_WITH_CURRENT_HEAD_AI_EVIDENCE; CODE_WITH_CURRENT_HEAD_AI_EVIDENCE_PLUS_OPERATOR_WARRANT; HIGH_OPERATOR_ONLY (operator, 2026-08-12)",
  "ruling_record": "reports/agentops/work_packets/WP-MIKE-P0-20260813.json",
  "prior_ruling_record": "docs/ops/OPERATOR_RULING_2026-07-29_AUTO_WITH_DECORRELATED_REVIEW.md",
  "confirmation_token_prefix": "automerge-policy-pass-",
  "rate_observation_advisory_per_day": 20,
  "autonomy_dial": {
    "env": "DGC_SARATHI_AUTONOMY",
    "levels": ["shadow", "propose", "dispatch", "full"],
    "default": "propose",
    "invalid_value_behavior": "shadow",
    "module": "dharma_swarm/operator_core/autonomy_dial.py"
  },
  "reversibility_floor": {
    "description": "Every unattended-lane PR at every tier: classify_action(pr_title, operator_reachable=False) must not classify OPERATOR_ONLY (NEVER_AUTO denylist and CRITICAL-risk vocabulary are the hard floor and do not move). Tier2 additionally requires every hit referee path clear of NEVER_AUTO substrings.",
    "module": "dharma_swarm/operator_core/reversibility_gate.py"
  },
  "reviewer_families": {
    "chatgpt-codex-connector[bot]": "openai",
    "copilot-pull-request-reviewer[bot]": "github-copilot"
  },
  "author_families": {
    "devin-ai-integration[bot]": "cognition",
    "github-actions[bot]": "automation",
    "Copilot": "github-copilot"
  },
  "authority_policy": {
    "authorization_evidence_schema": "dharma.merge_authorization_evidence.v1",
    "actuation_enabled": false,
    "operator_identities": ["AmitabhainArunachala"],
    "operator_warrant_source": "native current-head GitHub APPROVED review by an allowlisted operator",
    "classes": {
      "docs_low": {
        "candidate_for_unattended": true,
        "required_ai_evidence": 1,
        "operator_warrant": false,
        "description": "Strict low-risk documentation only. Deterministic gates remain authoritative; a current-head trusted AI review is required evidence, not an approval identity."
      },
      "code": {
        "candidate_for_unattended": true,
        "required_ai_evidence": 1,
        "operator_warrant": true,
        "description": "Code may be enqueued only with deterministic gates, current-head trusted AI evidence, and an exact current-head warrant from an allowlisted operator."
      },
      "operator_only": {
        "candidate_for_unattended": false,
        "required_ai_evidence": 0,
        "operator_warrant": true,
        "description": "Referee, governance, workflow, security, deployment, authority-policy, test-deletion, and other high-risk changes are never actuated by Mike."
      }
    },
    "docs_low_allow": ["docs/**"],
    "docs_low_deny": [
      "AGENTS.md",
      "**/AGENTS.md",
      "CLAUDE.md",
      "**/CLAUDE.md",
      ".github/**",
      ".agents/**",
      ".codex/**",
      "mode_pack/**",
      "**/SKILL.md",
      "**/SOUL.md",
      "**/*PROMPT*.md",
      "docs/agents/**",
      "docs/agent_tasks/**",
      "docs/governance/**",
      "docs/ops/**",
      "docs/prompts/**",
      "docs/referee/**",
      "docs/plans/handoffs/**"
    ],
    "operator_only_paths": [
      ".github/**",
      ".env*",
      "**/.env*",
      "AGENTS.md",
      "**/AGENTS.md",
      "CLAUDE.md",
      "**/CLAUDE.md",
      "CODEOWNERS",
      "deploy/**",
      "**/deploy/**",
      "infra/**",
      "**/infra/**",
      "infrastructure/**",
      "**/infrastructure/**",
      "migrations/**",
      "**/migrations/**",
      "security/**",
      "**/security/**",
      "**/credentials/**",
      "**/secrets/**",
      "docs/governance/**",
      "docs/ops/**",
      "docs/prompts/**",
      "docs/referee/**",
      "docs/plans/handoffs/**",
      ".agents/**",
      ".codex/**",
      "mode_pack/**",
      "**/SKILL.md",
      "**/SOUL.md",
      "**/*PROMPT*.md",
      "docs/agents/**",
      "docs/agent_tasks/**",
      "scripts/governance/**",
      "scripts/runtime/**",
      "dharma_swarm/operator_core/**",
      "dharma_swarm/risk_patterns.py"
    ]
  },
  "tiers": {
    "tier0": {
      "description": "Strict docs-low changes only; governance, operations, referee, handoff, prompt, and agent-instruction surfaces are excluded.",
      "max_diff_lines": 300,
      "required_ai_evidence": 1,
      "doc_only_paths": ["docs/", "*.md"]
    },
    "tier1": {
      "description": "Ordinary code: one current-head trusted AI review plus an exact current-head operator warrant.",
      "max_diff_lines": 600,
      "required_ai_evidence": 1,
      "operator_warrant": true,
      "test_deletion_promotes_operator_only": true
    },
    "tier2": {
      "description": "Referee/high-risk layer. Mike may report evidence but never invokes merge for this class.",
      "merge": "operator_only",
      "max_diff_lines": 400,
      "required_ai_evidence": 0,
      "operator_warrant": true,
      "paths": [
