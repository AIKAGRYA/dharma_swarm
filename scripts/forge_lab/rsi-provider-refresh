#!/usr/bin/env bash
set -euo pipefail

# Scheduled provider liveness: at most four tiny probes per hour. Credentials
# are resolved inside the provider layer and never appear in argv or output.
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# These are model IDs only. The default makes one bounded call to each of the
# two independently authorized, exactly priced first-party routes. A Moonshot
# 429 remains a typed external account blocker and is cached for the hourly
# refresh interval; unpriced Ollama and uncredentialed OpenAI are not treated as
# fallback capacity. Neither key presence nor a model alias counts.
export RSI_LAB_STAGED_MODELS="${RSI_LAB_STAGED_MODELS:-zhipu:glm-5.1,moonshot:kimi-k2.7-code}"
exec "${script_dir}/rsi" provider selftest \
    --profile staged \
    --live \
    --require-independent-routes 2 \
    --timeout-s 20 \
    --max-probes 4 \
    --min-refresh-interval-s 3600 \
    --json
