#!/usr/bin/env bash
set -euo pipefail
source /root/rsi-lab/bin/rsi-env
preset=${1:-calibration}; count=${2:-forever}
case "$preset" in
  smoke)       generations=2;  children=1; tasks=3;  max_tokens=800000;  budget_tokens=90000;  budget_usd=1.00 ;;
  calibration|n10) generations=10; children=1; tasks=5; max_tokens=4000000; budget_tokens=90000; budget_usd=3.00 ;;
  n20)         generations=20; children=1; tasks=5;  max_tokens=8000000;  budget_tokens=90000;  budget_usd=6.00 ;;
  power20)     generations=20; children=1; tasks=5;  max_tokens=14000000; budget_tokens=180000; budget_usd=10.00 ;;
  deep20)      generations=20; children=2; tasks=5;  max_tokens=24000000; budget_tokens=220000; budget_usd=18.00 ;;
  *) echo "usage: rsi-loop {smoke|calibration|n10|n20|power20|deep20} {COUNT|forever}" >&2; exit 2 ;;
esac
if [ "$count" != "forever" ]; then [[ "$count" =~ ^[0-9]+$ ]] || { echo "count must be number or forever" >&2; exit 2; }; fi
session="rsi-loop-${preset}-$(date -u +%Y%m%dT%H%M%SZ)"
run_dir="$RSI_STATE/rsi_runs/$session"; mkdir -p "$run_dir"
log="$RSI_STATE/rsi_runs/$session.log"
cat > "$run_dir/loop.sh" <<RUNEOF
#!/usr/bin/env bash
set -uo pipefail
source /root/rsi-lab/bin/rsi-env
cd "\$RSI_REPO"
echo "LOOP=$session START=\$(date -u +%Y-%m-%dT%H:%M:%SZ) preset=$preset count=$count"
i=0
while true; do
  i=\$((i+1))
  /root/rsi-lab/bin/rsi-keys-refresh || true
  echo "=== ITER \$i START \$(date -u +%Y-%m-%dT%H:%M:%SZ) ==="
  PYTHONUNBUFFERED=1 "\$RSI_PY" -u -m dharma_swarm.forge_lab.cli run \\
    --generations $generations --children $children --tasks $tasks \\
    --solver-model "\$RSI_DEFAULT_SOLVER" --verifier-model "\$RSI_DEFAULT_VERIFIER" --mutator-model "\$RSI_DEFAULT_MUTATOR" \\
    --budget-tokens $budget_tokens --budget-usd $budget_usd --max-experiment-tokens $max_tokens \\
    --propose-timeout 180 --grade-timeout 300 --rng-seed \$((20260708+i)) \\
    --source-repo "\$RSI_REPO" --mode shadow || echo "ITER \$i run exited nonzero (continuing)"
  echo "=== ITER \$i END \$(date -u +%Y-%m-%dT%H:%M:%SZ) ==="
  if [ "$count" != "forever" ] && [ "\$i" -ge "$count" ]; then break; fi
  sleep 30
done
echo "LOOP_END=\$(date -u +%Y-%m-%dT%H:%M:%SZ)"
RUNEOF
chmod +x "$run_dir/loop.sh"
tmux new-session -d -s "$session" "bash $(printf '%q' "$run_dir/loop.sh") 2>&1 | tee -a $(printf '%q' "$log")"
echo "Launching loop tmux session: $session"; echo "Log: $log"
echo "Tail: ssh meghadharma 'rsi-tail $session'"
echo "Stop: ssh meghadharma 'rsi-stop $session'"
