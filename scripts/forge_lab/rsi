#!/usr/bin/env bash
set -euo pipefail

# Keep every launcher pinned to the host's immutable current release. The Mac
# and Meghadharma intentionally use different runtime roots but identical code.
if [[ -n "${RSI_LAB_BASE:-}" ]]; then
    base="${RSI_LAB_BASE}"
elif [[ -d /root/rsi-lab/current ]]; then
    base="/root/rsi-lab/current"
else
    base="${HOME}/.dharma/rsi-lab/current"
fi
repo="${RSI_LAB_REPO:-${base}/repo}"
python="${RSI_LAB_PYTHON:-${base}/.venv/bin/python}"
pydeps="${RSI_LAB_PYDEPS:-${base}/pydeps}"

if [[ ! -x "${python}" ]]; then
    printf 'rsi: canonical Python is not executable: %s\n' "${python}" >&2
    exit 2
fi
if [[ ! -d "${repo}/dharma_swarm/forge_lab" ]]; then
    printf 'rsi: canonical checkout is not readable: %s\n' "${repo}" >&2
    exit 2
fi

export PYTHONDONTWRITEBYTECODE=1
export RSI_LAB_BASE="${base}"
export RSI_LAB_STATE="${RSI_LAB_STATE:-${base}/state}"
export RSI_LAB_REPO="${repo}"
export PYTHONPATH="${repo}:${pydeps}${PYTHONPATH:+:${PYTHONPATH}}"
cd "${repo}"
exec "${python}" -m dharma_swarm.forge_lab "$@"
