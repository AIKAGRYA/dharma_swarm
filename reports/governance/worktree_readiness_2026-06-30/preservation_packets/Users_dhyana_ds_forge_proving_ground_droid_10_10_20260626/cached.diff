+#!/usr/bin/env python3
+"""Provider oracle for the Dharma Forge Proving Ground.
+
+Probes the candidate-generation provider and emits a freshness-stamped proof.
+Offline-by-default: the ``local-deterministic`` provider performs no network I/O
+and produces a reproducible output sample from a fixed prompt. Live providers are
+refused unless an explicit lease is supplied, in which case they are still gated.
+"""
+
+from __future__ import annotations
+
+import argparse
+import sys
+from dataclasses import asdict, dataclass
+from datetime import datetime
+from pathlib import Path
+
+if __package__ in (None, ""):
+    sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+from scripts.runtime.forge_proving_ground_common import (  # noqa: E402
+    CUSTODY_DRY_RUN_ONLY,
+    CUSTODY_EXTERNAL_GATED,
+    DEFAULT_FRESHNESS_WINDOW_S,
+    iso,
+    parse_iso,
+    sha256_text,
+    utc_now,
+    write_json,
+)
+
+LOCAL_PROVIDER_ID = "local-deterministic"
+LOCAL_PROVIDER_MODEL = "local-det-v1"
+PROBE_PROMPT = "forge-proving-ground::provider-probe::v1"
+
+
+@dataclass(frozen=True)
+class ProviderProbe:
+    provider_id: str
+    model: str
+    mode: str
+    status: str
+    latency_ms: float
+    output_sample: str
+    generated_at: str
+    freshness_window_s: int
+    custody_label: str
+    fresh: bool
+    network_calls: int
+    reason: str = ""
+
+    def to_dict(self) -> dict:
+        return asdict(self)
+
+
+def probe_provider(
+    *,
+    provider_id: str = LOCAL_PROVIDER_ID,
+    model: str = LOCAL_PROVIDER_MODEL,
+    offline: bool = True,
+    live_lease: bool = False,
+    freshness_window_s: int = DEFAULT_FRESHNESS_WINDOW_S,
+    now: datetime | None = None,
+) -> ProviderProbe:
+    now = now or utc_now()
+    generated_at = iso(now)
+
+    if not offline:
+        if not live_lease:
+            return ProviderProbe(
+                provider_id=provider_id,
+                model=model,
+                mode="live_requested",
+                status="refused",
+                latency_ms=0.0,
+                output_sample="",
+                generated_at=generated_at,
+                freshness_window_s=freshness_window_s,
+                custody_label=CUSTODY_EXTERNAL_GATED,
+                fresh=False,
+                network_calls=0,
+                reason="live_provider_requires_explicit_lease",
+            )
+        # A leased live probe is still gated in this harness: we never perform
+        # real network I/O here. Honest refusal beats a faked live receipt.
+        return ProviderProbe(
+            provider_id=provider_id,
+            model=model,
+            mode="live_leased",
+            status="gated",
+            latency_ms=0.0,
+            output_sample="",
+            generated_at=generated_at,
+            freshness_window_s=freshness_window_s,
+            custody_label=CUSTODY_EXTERNAL_GATED,
+            fresh=False,
+            network_calls=0,
+            reason="live_network_io_not_performed_by_proving_ground",
+        )
+
+    # Offline deterministic probe: reproducible, no network.
+    output_sample = sha256_text(f"{provider_id}:{model}:{PROBE_PROMPT}")[:32]
+    return ProviderProbe(
+        provider_id=provider_id,
+        model=model,
+        mode="offline_local",
+        status="ok",
+        latency_ms=0.0,
+        output_sample=output_sample,
+        generated_at=generated_at,
+        freshness_window_s=freshness_window_s,
+        custody_label=CUSTODY_DRY_RUN_ONLY,
+        fresh=True,
+        network_calls=0,
+    )
+
+
+def is_fresh(probe: ProviderProbe, *, now: datetime | None = None) -> bool:
+    if probe.status != "ok":
+        return False
+    now = now or utc_now()
+    age = (now - parse_iso(probe.generated_at)).total_seconds()
+    return 0 <= age <= probe.freshness_window_s
+
+
+def write_provider_proof(probe: ProviderProbe, path: Path) -> Path:
+    payload = {"schema": "forge_provider_proof.v1", **probe.to_dict()}
+    return write_json(path, payload)
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--provider-id", default=LOCAL_PROVIDER_ID)
+    parser.add_argument("--model", default=LOCAL_PROVIDER_MODEL)
+    parser.add_argument("--live", action="store_true", help="request a live probe (refused without --lease)")
+    parser.add_argument("--lease", action="store_true", help="assert an explicit operator lease")
+    parser.add_argument("--output-json", type=Path)
+    parser.add_argument("--json", action="store_true")
+    return parser
+
+
+def main(argv: list[str] | None = None) -> int:
+    args = build_parser().parse_args(argv)
+    probe = probe_provider(
+        provider_id=args.provider_id,
+        model=args.model,
+        offline=not args.live,
+        live_lease=args.lease,
+    )
+    payload = {"schema": "forge_provider_proof.v1", **probe.to_dict()}
+    if args.output_json:
+        write_provider_proof(probe, args.output_json)
+    if args.json or not args.output_json:
+        import json
+
+        print(json.dumps(payload, indent=2, sort_keys=True))
+    return 0 if probe.status == "ok" else 3
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
