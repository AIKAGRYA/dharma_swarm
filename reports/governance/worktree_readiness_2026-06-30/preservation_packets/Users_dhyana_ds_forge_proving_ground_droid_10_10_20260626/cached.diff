+"""Tests for the proving-ground autoresearch step."""
+
+import pytest
+
+from scripts.runtime.forge_proving_ground_autoresearch import propose_candidates
+from scripts.runtime.forge_real_benchmark_adapter import load_benchmark
+
+
+def test_proposes_reference_fix_candidate():
+    task = load_benchmark()
+    candidates, bounds = propose_candidates(task, "sample-output")
+    assert len(candidates) == 1
+    cand = candidates[0]
+    assert cand.files[task.solution_filename] == task.reference_files[task.solution_filename]
+    assert cand.rationale
+    assert task.solution_filename in cand.diffs
+
+
+def test_candidate_does_not_edit_hidden_test():
+    task = load_benchmark()
+    candidates, _ = propose_candidates(task, "sample-output")
+    cand = candidates[0]
+    assert cand.files[task.test_filename] == task.baseline_files[task.test_filename]
+
+
+def test_bounds_attestation_offline_no_external():
+    task = load_benchmark()
+    _, bounds = propose_candidates(task, "sample-output", max_candidates=3)
+    assert bounds.no_external_calls is True
+    assert bounds.offline is True
+    assert bounds.deterministic is True
+    assert bounds.max_candidates == 3
+    assert bounds.candidates_emitted <= bounds.max_candidates
+
+
+def test_deterministic_candidate_id():
+    task = load_benchmark()
+    a, _ = propose_candidates(task, "fixed-sample")
+    b, _ = propose_candidates(task, "fixed-sample")
+    assert a[0].candidate_id == b[0].candidate_id
+
+
+def test_invalid_max_candidates():
+    task = load_benchmark()
+    with pytest.raises(ValueError):
+        propose_candidates(task, "x", max_candidates=0)
