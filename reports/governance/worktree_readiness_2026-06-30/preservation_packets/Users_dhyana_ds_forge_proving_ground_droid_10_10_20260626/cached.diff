index 000000000..08eaa39ad
--- /dev/null
+++ b/scripts/runtime/forge_proving_ground_run.py
@@ -0,0 +1,239 @@
+#!/usr/bin/env python3
+"""Orchestrator for a single Dharma Forge Proving Ground run.
+
+Runs the bounded, offline-by-default loop (provider oracle -> real benchmark ->
+autoresearch -> patch sandbox -> independent verifier) and writes a directory of
+honest receipts under ``reports/forge/proving_ground/fpg-<utc>-<shorthash>/``.
+The run makes no external, public-benchmark, or archive-fitness claim.
+"""
+
+from __future__ import annotations
+
+import argparse
+import sys
+import tempfile
+from dataclasses import dataclass
+from datetime import datetime
+from pathlib import Path
+
+if __package__ in (None, ""):
+    sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+from scripts.runtime.forge_proving_ground_autoresearch import (  # noqa: E402
+    build_proposal_payload,
+    propose_candidates,
+)
+from scripts.runtime.forge_proving_ground_common import (  # noqa: E402
+    CUSTODY_DRY_RUN_ONLY,
+    CUSTODY_SOURCE_OWNED,
+    DEFAULT_FRESHNESS_WINDOW_S,
+    FORBIDDEN_ACTIONS,
+    LOCAL_FIXTURE,
+    PROVING_GROUND_ROOT,
+    iso,
+    new_run_identity,
+    read_json,
+    run_dir_name,
+    sha256_file,
+    utc_now,
+    write_json,
+)
+from scripts.runtime.forge_proving_ground_patch_sandbox import (  # noqa: E402
+    build_sandbox_payload,
+    run_sandbox,
+)
+from scripts.runtime.forge_proving_ground_verifier import (  # noqa: E402
+    build_verdict_payload,
+    verify_run,
+)
+from scripts.runtime.forge_provider_oracle import (  # noqa: E402
+    probe_provider,
+    write_provider_proof,
+)
+from scripts.runtime.forge_real_benchmark_adapter import (  # noqa: E402
+    load_benchmark,
+    score_files,
+)
+
+RECEIPT_FILES = (
+    "provider_proof.json",
+    "benchmark_proof.json",
+    "autoresearch_proposal.json",
+    "patch_sandbox_result.json",
+    "authority_attestation.json",
+    "run_summary.json",
+)
+
+
+@dataclass
+class RunResult:
+    run_dir: Path
+    run_id: str
+    verdict: str
+    before_score: float
+    after_score: float
+    decision: str
+
+
+def latest_run_dir(out_root: Path = PROVING_GROUND_ROOT) -> Path | None:
+    out_root = Path(out_root)
+    if not out_root.exists():
+        return None
+    candidates = sorted(p for p in out_root.iterdir() if p.is_dir() and p.name.startswith("fpg-"))
+    return candidates[-1] if candidates else None
+
+
+def run_proving_ground(
+    *,
+    out_root: Path = PROVING_GROUND_ROOT,
+    now: datetime | None = None,
+    externality_level: str = LOCAL_FIXTURE,
+    lease: str | None = None,
+    max_candidates: int = 1,
+    freshness_window_s: int = DEFAULT_FRESHNESS_WINDOW_S,
+    timeout_s: int = 60,
+) -> RunResult:
+    now = now or utc_now()
+    identity = new_run_identity()
+    run_dir = Path(out_root) / run_dir_name(now, identity["run_id"])
+    run_dir.mkdir(parents=True, exist_ok=True)
+
+    # 1. Provider oracle.
+    probe = probe_provider(now=now, freshness_window_s=freshness_window_s)
+    write_provider_proof(probe, run_dir / "provider_proof.json")
+
+    # 2. Real benchmark + baseline score.
+    task = load_benchmark(externality_level=externality_level, lease=lease)
+    with tempfile.TemporaryDirectory(prefix="forge-pg-baseline-") as tmp:
+        baseline = score_files(Path(tmp) / "baseline", task, task.baseline_files, timeout_s=timeout_s)
+    write_json(
+        run_dir / "benchmark_proof.json",
+        {
+            "schema": "forge_benchmark_proof.v1",
+            **task.to_proof_dict(),
+            "baseline_score": baseline.score,
+            "baseline_evidence": baseline.to_dict(),
+            "externality_proof_strength": (
+                "real_local_execution" if baseline.command else "unverified"
+            ),
+        },
+    )
+
+    # 3. Autoresearch proposal.
+    candidates, bounds = propose_candidates(task, probe.output_sample, max_candidates=max_candidates)
+    write_json(
+        run_dir / "autoresearch_proposal.json",
+        build_proposal_payload(task, candidates, bounds),
+    )
+
+    # 4. Patch sandbox (isolated, ephemeral temp dir; never the real repo). The
+    # receipts capture before/after evidence, so the sandbox tree is discarded.
+    with tempfile.TemporaryDirectory(prefix="forge-pg-sandbox-") as sb_tmp:
+        sandbox = run_sandbox(task, candidates[0], sandbox_root=Path(sb_tmp), timeout_s=timeout_s)
+    write_json(run_dir / "patch_sandbox_result.json", build_sandbox_payload(sandbox))
+
+    # 5. Authority attestation.
+    write_json(
+        run_dir / "authority_attestation.json",
+        {
+            "schema": "forge_authority_attestation.v1",
+            "forbidden_actions": {name: "not_taken" for name in FORBIDDEN_ACTIONS},
+            "offline": True,
+            "network_calls": 0,
+            "lease": lease,
+            "externality_level": externality_level,
+            "custody_label": CUSTODY_DRY_RUN_ONLY,
+        },
+    )
+
+    # 6. Honest run summary (no external/SOTA claim).
+    write_json(
+        run_dir / "run_summary.json",
+        {
+            "schema": "forge_run_summary.v1",
+            "identity": identity,
+            "generated_at": iso(now),
+            "externality_level": externality_level,
+            "before_score": sandbox.before_score,
+            "after_score": sandbox.after_score,
+            "delta": sandbox.delta,
+            "decision": sandbox.decision,
+            "candidate_id": sandbox.candidate_id,
+            "custody_label": CUSTODY_DRY_RUN_ONLY,
+            "source_custody_label": CUSTODY_SOURCE_OWNED,
+            "claims": {
+                "public_benchmark_performance": False,
+                "external_receipt": False,
+                "archive_fitness_changed": False,
+                "trusted_memory_promoted": False,
+                "router_mutated": False,
+                "sota_complete": False,
+            },
+            "interpretation": (
+                "Local dry-run proof of the forge self-improvement loop on a "
+                "locally executed fixture benchmark; independently verified in the "
+                "same checkout. Candidate evidence only."
+            ),
+        },
+    )
+
+    # 7. Manifest ties every receipt to the canonical identity with hashes.
+    receipts = []
+    for name in RECEIPT_FILES:
+        path = run_dir / name
+        receipts.append({"path": name, "sha256": sha256_file(path)})
+    write_json(
+        run_dir / "run_manifest.json",
+        {
+            "schema": "forge_run_manifest.v1",
+            "identity": identity,
+            "generated_at": iso(now),
+            "externality_level": externality_level,
+            "receipts": receipts,
+            "custody_label": CUSTODY_DRY_RUN_ONLY,
+        },
+    )
+
+    # 8. Independent verifier (runs after the manifest is sealed).
+    verdict = verify_run(run_dir, timeout_s=timeout_s)
+    write_json(run_dir / "verifier_verdict.json", build_verdict_payload(verdict))
+
+    return RunResult(
+        run_dir=run_dir,
+        run_id=identity["run_id"],
+        verdict=verdict.verdict,
+        before_score=sandbox.before_score,
+        after_score=sandbox.after_score,
+        decision=sandbox.decision,
+    )
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out-root", type=Path, default=PROVING_GROUND_ROOT)
+    parser.add_argument("--externality-level", default=LOCAL_FIXTURE)
+    parser.add_argument("--lease", default=None)
+    parser.add_argument("--max-candidates", type=int, default=1)
+    parser.add_argument("--json", action="store_true")
+    return parser
+
+
+def main(argv: list[str] | None = None) -> int:
+    import json
+
+    args = build_parser().parse_args(argv)
+    result = run_proving_ground(
+        out_root=args.out_root,
+        externality_level=args.externality_level,
+        lease=args.lease,
+        max_candidates=args.max_candidates,
+    )
+    summary = read_json(result.run_dir / "run_summary.json")
+    summary["run_dir"] = str(result.run_dir)
+    summary["verifier_verdict"] = result.verdict
+    print(json.dumps(summary, indent=2, sort_keys=True))
+    return 0 if result.verdict == "PASS" else 6
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
