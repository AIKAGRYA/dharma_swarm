+#!/usr/bin/env python3
+"""Isolated patch sandbox for the Dharma Forge Proving Ground.
+
+Applies a candidate patch to a throwaway sandbox directory (never the real repo),
+scores the benchmark before and after, and decides keep/revert from the measured
+delta. Asserts the candidate writes only inside the sandbox and touches no
+protected path.
+"""
+
+from __future__ import annotations
+
+import sys
+import tempfile
+from dataclasses import asdict, dataclass, field
+from pathlib import Path
+
+if __package__ in (None, ""):
+    sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+from scripts.runtime.forge_proving_ground_autoresearch import Candidate  # noqa: E402
+from scripts.runtime.forge_proving_ground_common import (  # noqa: E402
+    PROTECTED_PATH_MARKERS,
+)
+from scripts.runtime.forge_real_benchmark_adapter import (  # noqa: E402
+    BenchmarkTask,
+    ScoreResult,
+    score_files,
+)
+
+DECISION_KEEP = "keep"
+DECISION_REVERT = "revert"
+
+
+class ProtectedPathViolation(RuntimeError):
+    """Raised when a candidate would write outside the sandbox or to a protected path."""
+
+
+@dataclass
+class SandboxResult:
+    candidate_id: str
+    sandbox_path: str
+    before_score: float
+    after_score: float
+    delta: float
+    decision: str
+    before_evidence: dict
+    after_evidence: dict
+    protected_path_attestation: dict
+    written_paths: list[str] = field(default_factory=list)
+
+    def to_dict(self) -> dict:
+        return asdict(self)
+
+
+def _assert_within_sandbox(sandbox: Path, files: dict[str, str]) -> list[str]:
+    sandbox = sandbox.resolve()
+    written: list[str] = []
+    for name in files:
+        target = (sandbox / name).resolve()
+        try:
+            target.relative_to(sandbox)
+        except ValueError as exc:
+            raise ProtectedPathViolation(f"candidate path escapes sandbox: {name}") from exc
+        lowered = name.lower()
+        for marker in PROTECTED_PATH_MARKERS:
+            if marker in lowered:
+                raise ProtectedPathViolation(
+                    f"candidate path touches protected marker {marker!r}: {name}"
+                )
+        written.append(str(target))
+    return written
+
+
+def run_sandbox(
+    task: BenchmarkTask,
+    candidate: Candidate,
+    *,
+    sandbox_root: Path | None = None,
+    timeout_s: int = 60,
+) -> SandboxResult:
+    root = Path(sandbox_root) if sandbox_root else Path(tempfile.mkdtemp(prefix="forge-pg-sandbox-"))
+    root.mkdir(parents=True, exist_ok=True)
+
+    # Validate hygiene before touching disk with candidate content.
+    written = _assert_within_sandbox(root, candidate.files)
+
+    before_dir = root / "before"
+    after_dir = root / "after"
+
+    before: ScoreResult = score_files(before_dir, task, task.baseline_files, timeout_s=timeout_s)
+    after: ScoreResult = score_files(after_dir, task, candidate.files, timeout_s=timeout_s)
+
+    delta = after.score - before.score
+    decision = DECISION_KEEP if delta > 0 else DECISION_REVERT
+
+    attestation = {
+        "all_paths_within_sandbox": True,
+        "protected_markers_checked": list(PROTECTED_PATH_MARKERS),
+        "touched_protected_path": False,
+        "real_repo_mutated": False,
+        "sandbox_root": str(root),
+    }
+
+    return SandboxResult(
+        candidate_id=candidate.candidate_id,
+        sandbox_path=str(root),
+        before_score=before.score,
+        after_score=after.score,
+        delta=delta,
+        decision=decision,
+        before_evidence=before.to_dict(),
+        after_evidence=after.to_dict(),
+        protected_path_attestation=attestation,
+        written_paths=written,
+    )
+
+
+def build_sandbox_payload(result: SandboxResult) -> dict:
+    return {"schema": "forge_patch_sandbox_result.v1", **result.to_dict()}
