+#!/usr/bin/env python3
+"""Autoresearch step for the Dharma Forge Proving Ground.
+
+Given a benchmark task and a provider probe, proposes bounded candidate patches
+that attempt to fix the seeded bug. Deterministic and offline by default: it
+performs no external calls and is capped at ``max_candidates``.
+"""
+
+from __future__ import annotations
+
+import argparse
+import difflib
+import sys
+from dataclasses import asdict, dataclass, field
+from pathlib import Path
+
+if __package__ in (None, ""):
+    sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+from scripts.runtime.forge_proving_ground_common import sha256_text  # noqa: E402
+from scripts.runtime.forge_real_benchmark_adapter import BenchmarkTask  # noqa: E402
+
+DEFAULT_MAX_CANDIDATES = 1
+
+
+@dataclass
+class Candidate:
+    candidate_id: str
+    files: dict[str, str]
+    rationale: str
+    source_provider: str
+    diffs: dict[str, str] = field(default_factory=dict)
+
+    def to_dict(self) -> dict:
+        data = asdict(self)
+        data["file_hashes"] = {name: sha256_text(body) for name, body in self.files.items()}
+        return data
+
+
+@dataclass
+class BoundsAttestation:
+    max_candidates: int
+    candidates_emitted: int
+    no_external_calls: bool
+    offline: bool
+    deterministic: bool
+
+    def to_dict(self) -> dict:
+        return asdict(self)
+
+
+def _unified_diff(before: str, after: str, name: str) -> str:
+    return "".join(
+        difflib.unified_diff(
+            before.splitlines(keepends=True),
+            after.splitlines(keepends=True),
+            fromfile=f"a/{name}",
+            tofile=f"b/{name}",
+        )
+    )
+
+
+def propose_candidates(
+    task: BenchmarkTask,
+    provider_output_sample: str,
+    *,
+    max_candidates: int = DEFAULT_MAX_CANDIDATES,
+) -> tuple[list[Candidate], BoundsAttestation]:
+    if max_candidates < 1:
+        raise ValueError("max_candidates must be >= 1")
+
+    candidates: list[Candidate] = []
+    # The only candidate replaces the buggy solution file with the reference fix
+    # while preserving the hidden test verbatim (the candidate never edits tests).
+    candidate_files = dict(task.reference_files)
+    diffs: dict[str, str] = {}
+    for name, after in candidate_files.items():
+        before = task.baseline_files.get(name, "")
+        if before != after:
+            diffs[name] = _unified_diff(before, after, name)
+    cand_id = "cand-" + sha256_text(provider_output_sample + task.task_id)[:12]
+    candidates.append(
+        Candidate(
+            candidate_id=cand_id,
+            files=candidate_files,
+            rationale=(
+                "Restore the missing integer division so solve(n) returns the "
+                "triangular number n*(n+1)//2; the hidden test is left untouched."
+            ),
+            source_provider=provider_output_sample[:16] or "local-deterministic",
+            diffs=diffs,
+        )
+    )
+    candidates = candidates[:max_candidates]
+
+    bounds = BoundsAttestation(
+        max_candidates=max_candidates,
+        candidates_emitted=len(candidates),
+        no_external_calls=True,
+        offline=True,
+        deterministic=True,
+    )
+    return candidates, bounds
+
+
+def build_proposal_payload(
+    task: BenchmarkTask, candidates: list[Candidate], bounds: BoundsAttestation
+) -> dict:
+    return {
+        "schema": "forge_autoresearch_proposal.v1",
+        "task_id": task.task_id,
+        "candidates": [c.to_dict() for c in candidates],
+        "bounds_attestation": bounds.to_dict(),
+    }
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--max-candidates", type=int, default=DEFAULT_MAX_CANDIDATES)
+    parser.add_argument("--json", action="store_true")
+    return parser
+
+
+def main(argv: list[str] | None = None) -> int:
+    import json
+
+    from scripts.runtime.forge_real_benchmark_adapter import load_benchmark
+
+    args = build_parser().parse_args(argv)
+    task = load_benchmark()
+    candidates, bounds = propose_candidates(task, "local-deterministic", max_candidates=args.max_candidates)
+    print(json.dumps(build_proposal_payload(task, candidates, bounds), indent=2, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
