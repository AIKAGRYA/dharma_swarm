+"""Tests for the proving-ground isolated patch sandbox."""
+
+import pytest
+
+from scripts.runtime.forge_proving_ground_autoresearch import Candidate, propose_candidates
+from scripts.runtime.forge_proving_ground_patch_sandbox import (
+    ProtectedPathViolation,
+    run_sandbox,
+)
+from scripts.runtime.forge_real_benchmark_adapter import load_benchmark
+
+
+def test_keep_decision_on_real_improvement(tmp_path):
+    task = load_benchmark()
+    candidates, _ = propose_candidates(task, "sample")
+    result = run_sandbox(task, candidates[0], sandbox_root=tmp_path / "sb")
+    assert result.before_score == 0.0
+    assert result.after_score == 1.0
+    assert result.delta == 1.0
+    assert result.decision == "keep"
+    assert result.before_evidence["returncode"] != 0
+    assert result.after_evidence["returncode"] == 0
+
+
+def test_revert_decision_when_no_improvement(tmp_path):
+    task = load_benchmark()
+    # A candidate identical to the buggy baseline yields no improvement.
+    bad = Candidate(
+        candidate_id="noop",
+        files=dict(task.baseline_files),
+        rationale="noop",
+        source_provider="local",
+    )
+    result = run_sandbox(task, bad, sandbox_root=tmp_path / "sb")
+    assert result.before_score == result.after_score
+    assert result.decision == "revert"
+
+
+def test_protected_path_marker_rejected(tmp_path):
+    task = load_benchmark()
+    evil = Candidate(
+        candidate_id="evil",
+        files={"router/config.py": "x = 1"},
+        rationale="malicious",
+        source_provider="local",
+    )
+    with pytest.raises(ProtectedPathViolation):
+        run_sandbox(task, evil, sandbox_root=tmp_path / "sb")
+
+
+def test_sandbox_escape_rejected(tmp_path):
+    task = load_benchmark()
+    evil = Candidate(
+        candidate_id="escape",
+        files={"../escape.py": "x = 1"},
+        rationale="escape",
+        source_provider="local",
+    )
+    with pytest.raises(ProtectedPathViolation):
+        run_sandbox(task, evil, sandbox_root=tmp_path / "sb")
+
+
+def test_attestation_clean(tmp_path):
+    task = load_benchmark()
+    candidates, _ = propose_candidates(task, "sample")
+    result = run_sandbox(task, candidates[0], sandbox_root=tmp_path / "sb")
+    att = result.protected_path_attestation
+    assert att["touched_protected_path"] is False
+    assert att["real_repo_mutated"] is False
+    assert str(tmp_path) in result.sandbox_path
