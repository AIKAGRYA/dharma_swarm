@@ -0,0 +1,54 @@
+"""Tests for the independent proving-ground verifier."""
+
+from scripts.runtime.forge_proving_ground_common import read_json, write_json
+from scripts.runtime.forge_proving_ground_run import run_proving_ground
+from scripts.runtime.forge_proving_ground_verifier import verify_run
+
+
+def _make_run(tmp_path):
+    result = run_proving_ground(out_root=tmp_path / "runs")
+    return result.run_dir
+
+
+def test_verifier_passes_on_honest_run(tmp_path):
+    run_dir = _make_run(tmp_path)
+    verdict = verify_run(run_dir)
+    assert verdict.verdict == "PASS"
+    assert verdict.agreement is True
+    assert verdict.recomputed_before == 0.0
+    assert verdict.recomputed_after == 1.0
+    assert verdict.independence_attestation["verifier_reran_benchmark_subprocess"] is True
+
+
+def test_verifier_catches_score_lie(tmp_path):
+    run_dir = _make_run(tmp_path)
+    # Tamper: claim the candidate already passed at baseline (a lie).
+    sb_path = run_dir / "patch_sandbox_result.json"
+    sb = read_json(sb_path)
+    sb["before_score"] = 1.0
+    sb["after_score"] = 1.0
+    write_json(sb_path, sb)
+
+    verdict = verify_run(run_dir)
+    assert verdict.verdict == "FAIL"
+    # The independent recomputation still shows the true 0.0 -> 1.0.
+    assert verdict.recomputed_before == 0.0
+    assert verdict.recomputed_after == 1.0
+    assert verdict.agreement is False
+
+
+def test_verifier_fails_on_missing_receipt(tmp_path):
+    run_dir = _make_run(tmp_path)
+    (run_dir / "benchmark_proof.json").unlink()
+    verdict = verify_run(run_dir)
+    assert verdict.verdict == "FAIL"
+
+
+def test_verifier_detects_authority_violation(tmp_path):
+    run_dir = _make_run(tmp_path)
+    auth_path = run_dir / "authority_attestation.json"
+    auth = read_json(auth_path)
+    auth["forbidden_actions"]["self_merge"] = "taken"
+    write_json(auth_path, auth)
+    verdict = verify_run(run_dir)
+    assert verdict.verdict == "FAIL"
