+#!/usr/bin/env python3
+"""Shared primitives for the Dharma Forge Proving Ground harness.
+
+Stop-safe, offline-by-default helpers used by the proving-ground components,
+orchestrator, and readiness grader. Reuses the Runtime Truth Spine
+(``ExecutionIdentity``) for canonical run/trace identity and the canonical
+``RuntimeTruthState`` custody labels rather than inventing parallel primitives.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+from dharma_swarm.operator_core.contracts import RuntimeTruthState
+from dharma_swarm.spine import ExecutionIdentity
+
+PROVING_GROUND_ROOT = Path("reports/forge/proving_ground")
+
+# Externality ladder for the benchmark adapter. Only LOCAL_FIXTURE is allowed
+# without an explicit operator lease.
+LOCAL_FIXTURE = "local_fixture"
+PUBLIC_BENCHMARK = "public_benchmark"
+SUBMITTED_BENCHMARK = "submitted_benchmark"
+EXTERNALITY_LEVELS = (LOCAL_FIXTURE, PUBLIC_BENCHMARK, SUBMITTED_BENCHMARK)
+LEASE_REQUIRED_LEVELS = (PUBLIC_BENCHMARK, SUBMITTED_BENCHMARK)
+
+# Canonical custody labels (reused, not redefined).
+CUSTODY_SOURCE_OWNED = RuntimeTruthState.SOURCE_OWNED.value
+CUSTODY_DRY_RUN_ONLY = RuntimeTruthState.DRY_RUN_ONLY.value
+CUSTODY_EXTERNAL_GATED = RuntimeTruthState.EXTERNAL_GATED.value
+CUSTODY_PROJECTION_ONLY = RuntimeTruthState.PROJECTION_ONLY.value
+
+# Authority boundaries that every run attests it did not cross.
+FORBIDDEN_ACTIONS = (
+    "public_benchmark_submission",
+    "external_outreach",
+    "paid_action",
+    "production_router_mutation",
+    "archive_fitness_mutation",
+    "trusted_memory_promotion",
+    "self_merge",
+    "protected_identity_mutation",
+)
+
+# Substrings that must never appear in a path the sandbox writes to.
+PROTECTED_PATH_MARKERS = (
+    "archive_fitness",
+    "trusted_memory",
+    "model_hierarchy",
+    "router",
+    ".git",
+    "/.dharma/",
+)
+
+DEFAULT_FRESHNESS_WINDOW_S = 86_400
+
+
+def utc_now() -> datetime:
+    return datetime.now(timezone.utc)
+
+
+def iso(dt: datetime) -> str:
+    return dt.astimezone(timezone.utc).isoformat()
+
+
+def parse_iso(value: str) -> datetime:
+    parsed = datetime.fromisoformat(value)
+    if parsed.tzinfo is None:
+        parsed = parsed.replace(tzinfo=timezone.utc)
+    return parsed
+
+
+def sha256_bytes(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def sha256_text(text: str) -> str:
+    return sha256_bytes(text.encode("utf-8"))
+
+
+def sha256_file(path: Path) -> str:
+    return sha256_bytes(Path(path).read_bytes())
+
+
+def canonical_json(payload: Any) -> str:
+    return json.dumps(payload, indent=2, sort_keys=True, default=str)
+
+
+def write_json(path: Path, payload: Any) -> Path:
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(canonical_json(payload) + "\n", encoding="utf-8")
+    return path
+
+
+def read_json(path: Path) -> Any:
+    return json.loads(Path(path).read_text(encoding="utf-8"))
+
+
+def new_run_identity(task_id: str = "forge_proving_ground", agent_id: str = "forge_pg") -> dict[str, str]:
+    """Mint canonical join keys via the Spine identity primitive."""
+
+    ident = ExecutionIdentity.new(task_id=task_id, agent_id=agent_id)
+    return {
+        "run_id": ident.run_id,
+        "trace_id": ident.trace_id,
+        "correlation_id": ident.correlation_id,
+        "task_id": ident.task_id,
+        "claim_id": ident.claim_id,
+        "idempotency_key": ident.idempotency_key,
+        "agent_id": ident.agent_id or agent_id,
+    }
+
+
+def run_dir_name(now: datetime, run_id: str) -> str:
+    stamp = now.astimezone(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
+    short = sha256_text(run_id)[:8]
+    return f"fpg-{stamp}-{short}"
