+"""Tests for the proving-ground run orchestrator."""
+
+from scripts.runtime.forge_proving_ground_common import read_json, sha256_file
+from scripts.runtime.forge_proving_ground_run import (
+    RECEIPT_FILES,
+    latest_run_dir,
+    run_proving_ground,
+)
+
+
+def test_run_writes_all_receipts_and_passes(tmp_path):
+    result = run_proving_ground(out_root=tmp_path / "runs")
+    assert result.verdict == "PASS"
+    assert result.before_score == 0.0
+    assert result.after_score == 1.0
+    assert result.decision == "keep"
+    for name in (*RECEIPT_FILES, "run_manifest.json", "verifier_verdict.json"):
+        assert (result.run_dir / name).exists(), name
+
+
+def test_manifest_hashes_match_receipts(tmp_path):
+    result = run_proving_ground(out_root=tmp_path / "runs")
+    manifest = read_json(result.run_dir / "run_manifest.json")
+    for entry in manifest["receipts"]:
+        assert sha256_file(result.run_dir / entry["path"]) == entry["sha256"]
+    assert manifest["identity"]["run_id"] == result.run_id
+
+
+def test_run_summary_makes_no_overclaim(tmp_path):
+    result = run_proving_ground(out_root=tmp_path / "runs")
+    summary = read_json(result.run_dir / "run_summary.json")
+    assert all(value is False for value in summary["claims"].values())
+    assert summary["custody_label"] == "dry_run_only"
+
+
+def test_latest_run_dir(tmp_path):
+    out_root = tmp_path / "runs"
+    assert latest_run_dir(out_root) is None
+    r1 = run_proving_ground(out_root=out_root)
+    latest = latest_run_dir(out_root)
+    assert latest == r1.run_dir
+
+
+def test_run_dir_uses_fpg_prefix(tmp_path):
+    result = run_proving_ground(out_root=tmp_path / "runs")
+    assert result.run_dir.name.startswith("fpg-")
