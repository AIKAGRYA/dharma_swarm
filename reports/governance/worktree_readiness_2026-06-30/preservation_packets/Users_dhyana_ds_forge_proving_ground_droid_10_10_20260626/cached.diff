new file mode 100644
index 000000000..58e9b676b
--- /dev/null
+++ b/scripts/runtime/forge_proving_ground_verifier.py
@@ -0,0 +1,179 @@
+#!/usr/bin/env python3
+"""Independent verifier for the Dharma Forge Proving Ground.
+
+Re-derives the verdict from the raw run artifacts. It re-checks every receipt
+hash against the manifest and independently re-runs the benchmark scorer on the
+baseline and candidate files (recomputing before/after scores from scratch rather
+than trusting the run's recorded numbers). PASS is returned only when the
+independent recomputation agrees with the run's claims and all hygiene checks
+hold. Residual risk: the verifier runs in-process from the same checkout, so it
+is not a fully inaccessible third-party verifier.
+"""
+
+from __future__ import annotations
+
+import sys
+import tempfile
+from dataclasses import asdict, dataclass, field
+from pathlib import Path
+
+if __package__ in (None, ""):
+    sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+from scripts.runtime.forge_proving_ground_common import (  # noqa: E402
+    FORBIDDEN_ACTIONS,
+    read_json,
+    sha256_file,
+)
+from scripts.runtime.forge_real_benchmark_adapter import (  # noqa: E402
+    load_benchmark,
+    score_files,
+)
+
+REQUIRED_RECEIPTS = (
+    "provider_proof.json",
+    "benchmark_proof.json",
+    "autoresearch_proposal.json",
+    "patch_sandbox_result.json",
+    "authority_attestation.json",
+    "run_summary.json",
+)
+
+
+@dataclass
+class Check:
+    name: str
+    ok: bool
+    detail: str = ""
+
+    def to_dict(self) -> dict:
+        return asdict(self)
+
+
+@dataclass
+class VerifierVerdict:
+    verdict: str
+    checks: list[Check]
+    recomputed_before: float | None
+    recomputed_after: float | None
+    claimed_before: float | None
+    claimed_after: float | None
+    agreement: bool
+    independence_attestation: dict = field(default_factory=dict)
+
+    def to_dict(self) -> dict:
+        data = asdict(self)
+        data["checks"] = [c.to_dict() if isinstance(c, Check) else c for c in self.checks]
+        return data
+
+
+def verify_run(run_dir: Path, *, timeout_s: int = 60) -> VerifierVerdict:
+    run_dir = Path(run_dir)
+    checks: list[Check] = []
+
+    manifest_path = run_dir / "run_manifest.json"
+    manifest = read_json(manifest_path) if manifest_path.exists() else {}
+    checks.append(Check("manifest_present", manifest_path.exists()))
+
+    # 1. Every required receipt is present.
+    for name in REQUIRED_RECEIPTS:
+        checks.append(Check(f"receipt_present:{name}", (run_dir / name).exists()))
+
+    # 2. Manifest hashes match the on-disk receipts.
+    hashes_ok = True
+    for entry in manifest.get("receipts", []):
+        target = run_dir / entry["path"]
+        if not target.exists():
+            hashes_ok = False
+            continue
+        if sha256_file(target) != entry.get("sha256"):
+            hashes_ok = False
+    checks.append(Check("manifest_hashes_match", hashes_ok))
+
+    # 3. Independently recompute before/after by re-running the benchmark.
+    recomputed_before = recomputed_after = None
+    claimed_before = claimed_after = None
+    agreement = False
+    try:
+        bench = read_json(run_dir / "benchmark_proof.json")
+        proposal = read_json(run_dir / "autoresearch_proposal.json")
+        sandbox = read_json(run_dir / "patch_sandbox_result.json")
+
+        task = load_benchmark(
+            externality_level=bench["externality_level"],
+            lease=bench.get("lease"),
+            task_id=bench["task_id"],
+        )
+        candidate_files = proposal["candidates"][0]["files"]
+
+        # The candidate must not have edited the hidden test.
+        test_name = task.test_filename
+        checks.append(
+            Check(
+                "candidate_did_not_edit_test",
+                candidate_files.get(test_name) == task.baseline_files.get(test_name),
+            )
+        )
+
+        with tempfile.TemporaryDirectory(prefix="forge-pg-verify-") as tmp:
+            tmp_path = Path(tmp)
+            recomputed_before = score_files(tmp_path / "before", task, task.baseline_files, timeout_s=timeout_s).score
+            recomputed_after = score_files(tmp_path / "after", task, candidate_files, timeout_s=timeout_s).score
+
+        claimed_before = sandbox.get("before_score")
+        claimed_after = sandbox.get("after_score")
+        agreement = (recomputed_before == claimed_before) and (recomputed_after == claimed_after)
+        checks.append(Check("scores_agree_with_run", agreement,
+                            f"recomputed=({recomputed_before},{recomputed_after}) claimed=({claimed_before},{claimed_after})"))
+
+        # Decision must be consistent with the independently recomputed delta.
+        decision = sandbox.get("decision")
+        recomputed_delta = (recomputed_after or 0.0) - (recomputed_before or 0.0)
+        decision_ok = (decision == "keep" and recomputed_delta > 0) or (
+            decision == "revert" and recomputed_delta <= 0
+        )
+        checks.append(Check("decision_consistent", decision_ok, f"decision={decision} delta={recomputed_delta}"))
+
+        # Protected-path hygiene as recorded by the sandbox.
+        att = sandbox.get("protected_path_attestation", {})
+        checks.append(
+            Check(
+                "protected_path_clean",
+                att.get("touched_protected_path") is False and att.get("real_repo_mutated") is False,
+            )
+        )
+    except Exception as exc:  # noqa: BLE001 - any failure is a verifier FAIL, reported honestly
+        checks.append(Check("recompute_succeeded", False, f"{type(exc).__name__}: {exc}"))
+
+    # 4. Authority attestation: every forbidden action not_taken, offline.
+    try:
+        authority = read_json(run_dir / "authority_attestation.json")
+        actions = authority.get("forbidden_actions", {})
+        all_not_taken = all(actions.get(name) == "not_taken" for name in FORBIDDEN_ACTIONS)
+        offline_ok = authority.get("offline") is True and authority.get("network_calls") == 0
+        checks.append(Check("authority_all_not_taken", all_not_taken))
+        checks.append(Check("offline_attested", offline_ok))
+    except Exception as exc:  # noqa: BLE001
+        checks.append(Check("authority_readable", False, f"{type(exc).__name__}: {exc}"))
+
+    verdict = "PASS" if all(c.ok for c in checks) else "FAIL"
+    independence = {
+        "recomputed_from_raw_artifacts": ["before_score", "after_score", "decision_delta"],
+        "trusted_from_run_summary": [],
+        "verifier_reran_benchmark_subprocess": True,
+        "same_checkout_residual_risk": True,
+    }
+    return VerifierVerdict(
+        verdict=verdict,
+        checks=checks,
+        recomputed_before=recomputed_before,
+        recomputed_after=recomputed_after,
+        claimed_before=claimed_before,
+        claimed_after=claimed_after,
+        agreement=agreement,
+        independence_attestation=independence,
+    )
+
+
+def build_verdict_payload(verdict: VerifierVerdict) -> dict:
+    return {"schema": "forge_verifier_verdict.v1", **verdict.to_dict()}
diff --git a/scripts/runtime/forge_real_benchmark_adapter.py b/scripts/runtime/forge_real_benchmark_adapter.py
new file mode 100644
index 000000000..ab26da403
--- /dev/null
+++ b/scripts/runtime/forge_real_benchmark_adapter.py
@@ -0,0 +1,212 @@
+#!/usr/bin/env python3
+"""Real benchmark adapter for the Dharma Forge Proving Ground.
+
+Materializes a real, executable benchmark task (a seeded-bug coding task with a
+hidden test) and scores a solution by actually running the test in a subprocess.
+Externality is honestly labeled. Only ``local_fixture`` runs without an explicit
+operator lease; ``public_benchmark`` and ``submitted_benchmark`` are refused.
+"""
+
+from __future__ import annotations
+
+import argparse
+import subprocess
+import sys
+from dataclasses import asdict, dataclass, field
+from pathlib import Path
+
+if __package__ in (None, ""):
+    sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+from scripts.runtime.forge_proving_ground_common import (  # noqa: E402
+    EXTERNALITY_LEVELS,
+    LEASE_REQUIRED_LEVELS,
+    LOCAL_FIXTURE,
+    sha256_text,
+)
+
+SOLUTION_FILENAME = "solution.py"
+TEST_FILENAME = "hidden_test.py"
+
+# Baseline carries a seeded bug: forgets the integer division, so the running
+# sum is doubled and the hidden test fails. This makes the proving-ground delta
+# real (baseline fails, the candidate fix passes).
+BASELINE_SOLUTION = '''"""Seeded-bug baseline: triangular number is doubled."""
+
+
+def solve(n: int) -> int:
+    if n < 0:
+        raise ValueError("n must be non-negative")
+    return n * (n + 1)
+'''
+
+REFERENCE_SOLUTION = '''"""Reference fix: correct triangular number."""
+
+
+def solve(n: int) -> int:
+    if n < 0:
+        raise ValueError("n must be non-negative")
+    return n * (n + 1) // 2
+'''
+
+HIDDEN_TEST = '''"""Hidden test for the proving-ground benchmark task."""
+
+from solution import solve
+
+CASES = {0: 0, 1: 1, 4: 10, 10: 55, 100: 5050}
+
+
+def main() -> int:
+    for n, expected in CASES.items():
+        got = solve(n)
+        if got != expected:
+            print(f"FAIL solve({n})={got} expected {expected}")
+            return 1
+    try:
+        solve(-1)
+    except ValueError:
+        pass
+    else:
+        print("FAIL solve(-1) did not raise ValueError")
+        return 1
+    print("PASS")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
+'''
+
+TASK_DESCRIPTION = (
+    "Implement solve(n) returning the sum 0+1+...+n for non-negative n, "
+    "raising ValueError for negative n."
+)
+
+
+@dataclass(frozen=True)
+class BenchmarkTask:
+    task_id: str
+    externality_level: str
+    description: str
+    test_filename: str
+    solution_filename: str
+    baseline_files: dict[str, str]
+    reference_files: dict[str, str]
+    lease: str | None = None
+
+    def to_proof_dict(self) -> dict:
+        data = asdict(self)
+        # Receipts carry hashes of the fixture, not the full file bodies.
+        data["baseline_files"] = {
+            name: sha256_text(body) for name, body in self.baseline_files.items()
+        }
+        data["reference_files"] = {
+            name: sha256_text(body) for name, body in self.reference_files.items()
+        }
+        return data
+
+
+@dataclass
+class ScoreResult:
+    score: float
+    passed: bool
+    returncode: int
+    stdout: str
+    stderr: str
+    command: list[str] = field(default_factory=list)
+
+    def to_dict(self) -> dict:
+        return asdict(self)
+
+
+class ExternalityRefused(PermissionError):
+    """Raised when a gated externality level is requested without a lease."""
+
+
+def load_benchmark(
+    *,
+    externality_level: str = LOCAL_FIXTURE,
+    lease: str | None = None,
+    task_id: str = "triangular-sum-001",
+) -> BenchmarkTask:
+    if externality_level not in EXTERNALITY_LEVELS:
+        raise ValueError(f"unknown externality level: {externality_level}")
+    if externality_level in LEASE_REQUIRED_LEVELS and not lease:
+        raise ExternalityRefused(
+            f"externality level {externality_level!r} requires an explicit operator lease"
+        )
+    return BenchmarkTask(
+        task_id=task_id,
+        externality_level=externality_level,
+        description=TASK_DESCRIPTION,
+        test_filename=TEST_FILENAME,
+        solution_filename=SOLUTION_FILENAME,
+        baseline_files={SOLUTION_FILENAME: BASELINE_SOLUTION, TEST_FILENAME: HIDDEN_TEST},
+        reference_files={SOLUTION_FILENAME: REFERENCE_SOLUTION, TEST_FILENAME: HIDDEN_TEST},
+        lease=lease,
+    )
+
+
+def materialize(workdir: Path, files: dict[str, str]) -> list[Path]:
+    workdir = Path(workdir)
+    workdir.mkdir(parents=True, exist_ok=True)
+    written: list[Path] = []
+    for name, body in files.items():
+        target = workdir / name
+        target.write_text(body, encoding="utf-8")
+        written.append(target)
+    return written
+
+
+def score_workdir(workdir: Path, task: BenchmarkTask, *, timeout_s: int = 60) -> ScoreResult:
+    """Run the hidden test in ``workdir`` as a subprocess and score the result."""
+
+    command = [sys.executable, task.test_filename]
+    proc = subprocess.run(
+        command,
+        cwd=str(workdir),
+        capture_output=True,
+        text=True,
+        timeout=timeout_s,
+    )
+    passed = proc.returncode == 0
+    return ScoreResult(
+        score=1.0 if passed else 0.0,
+        passed=passed,
+        returncode=proc.returncode,
+        stdout=proc.stdout.strip(),
+        stderr=proc.stderr.strip(),
+        command=command,
+    )
+
+
+def score_files(
+    workdir: Path, task: BenchmarkTask, files: dict[str, str], *, timeout_s: int = 60
+) -> ScoreResult:
+    materialize(workdir, files)
+    return score_workdir(workdir, task, timeout_s=timeout_s)
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--externality-level", default=LOCAL_FIXTURE, choices=EXTERNALITY_LEVELS)
+    parser.add_argument("--lease", default=None)
+    parser.add_argument("--json", action="store_true")
+    return parser
+
+
+def main(argv: list[str] | None = None) -> int:
+    import json
+
+    args = build_parser().parse_args(argv)
+    try:
+        task = load_benchmark(externality_level=args.externality_level, lease=args.lease)
+    except ExternalityRefused as exc:
+        print(json.dumps({"status": "refused", "reason": str(exc)}, indent=2))
+        return 4
+    print(json.dumps({"schema": "forge_benchmark_task.v1", **task.to_proof_dict()}, indent=2, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
