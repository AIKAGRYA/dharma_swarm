+"""Tests for the proving-ground real benchmark adapter."""
+
+import pytest
+
+import scripts.runtime.forge_real_benchmark_adapter as adapter
+from scripts.runtime.forge_real_benchmark_adapter import (
+    ExternalityRefused,
+    load_benchmark,
+    score_files,
+)
+
+
+def test_load_local_fixture_no_lease():
+    task = load_benchmark()
+    assert task.externality_level == "local_fixture"
+    assert task.solution_filename in task.baseline_files
+    assert task.test_filename in task.baseline_files
+
+
+def test_public_benchmark_requires_lease():
+    with pytest.raises(ExternalityRefused):
+        load_benchmark(externality_level="public_benchmark")
+
+
+def test_submitted_benchmark_requires_lease():
+    with pytest.raises(ExternalityRefused):
+        load_benchmark(externality_level="submitted_benchmark")
+
+
+def test_public_benchmark_allowed_with_lease():
+    task = load_benchmark(externality_level="public_benchmark", lease="operator-lease-xyz")
+    assert task.lease == "operator-lease-xyz"
+
+
+def test_baseline_fails_and_reference_passes(tmp_path):
+    task = load_benchmark()
+    baseline = score_files(tmp_path / "baseline", task, task.baseline_files)
+    reference = score_files(tmp_path / "reference", task, task.reference_files)
+    assert baseline.passed is False
+    assert baseline.score == 0.0
+    assert reference.passed is True
+    assert reference.score == 1.0
+    assert reference.command  # real command captured
+    assert "PASS" in reference.stdout
+
+
+def test_proof_dict_hashes_not_raw_bodies():
+    task = load_benchmark()
+    proof = task.to_proof_dict()
+    # baseline_files in the proof are hashes, not the raw source bodies.
+    for value in proof["baseline_files"].values():
+        assert len(value) == 64  # sha256 hex
