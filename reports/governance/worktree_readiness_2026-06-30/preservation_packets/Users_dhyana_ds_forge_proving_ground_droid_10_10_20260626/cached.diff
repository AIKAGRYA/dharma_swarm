+"""Tests for the proving-ground provider oracle."""
+
+from datetime import timedelta
+
+import scripts.runtime.forge_provider_oracle as oracle
+from scripts.runtime.forge_proving_ground_common import (
+    CUSTODY_DRY_RUN_ONLY,
+    CUSTODY_EXTERNAL_GATED,
+    parse_iso,
+    utc_now,
+)
+
+
+def test_offline_probe_is_ok_fresh_and_no_network():
+    probe = oracle.probe_provider()
+    assert probe.status == "ok"
+    assert probe.mode == "offline_local"
+    assert probe.network_calls == 0
+    assert probe.fresh is True
+    assert probe.custody_label == CUSTODY_DRY_RUN_ONLY
+    assert probe.output_sample  # deterministic, non-empty
+
+
+def test_offline_probe_is_deterministic():
+    a = oracle.probe_provider()
+    b = oracle.probe_provider()
+    assert a.output_sample == b.output_sample
+
+
+def test_live_probe_without_lease_is_refused():
+    probe = oracle.probe_provider(offline=False, live_lease=False)
+    assert probe.status == "refused"
+    assert probe.network_calls == 0
+    assert probe.custody_label == CUSTODY_EXTERNAL_GATED
+
+
+def test_live_probe_with_lease_is_gated_not_faked():
+    probe = oracle.probe_provider(offline=False, live_lease=True)
+    assert probe.status == "gated"
+    assert probe.network_calls == 0
+    assert probe.output_sample == ""
+
+
+def test_is_fresh_window():
+    probe = oracle.probe_provider(freshness_window_s=100)
+    now = parse_iso(probe.generated_at)
+    assert oracle.is_fresh(probe, now=now) is True
+    assert oracle.is_fresh(probe, now=now + timedelta(seconds=99)) is True
+    assert oracle.is_fresh(probe, now=now + timedelta(seconds=101)) is False
+
+
+def test_write_provider_proof(tmp_path):
+    probe = oracle.probe_provider(now=utc_now())
+    path = oracle.write_provider_proof(probe, tmp_path / "provider_proof.json")
+    assert path.exists()
+    import json
+
+    payload = json.loads(path.read_text())
+    assert payload["schema"] == "forge_provider_proof.v1"
+    assert payload["status"] == "ok"
