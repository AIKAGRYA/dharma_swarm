index 000000000..61ad9793b
--- /dev/null
+++ b/scripts/runtime/forge_proving_ground_readiness.py
@@ -0,0 +1,311 @@
+#!/usr/bin/env python3
+"""Strict readiness grader for the Dharma Forge Proving Ground.
+
+Scores the latest proving-ground run plus the codebase against ten machine-
+checkable criteria (see docs/agent_tasks/2026-06-26_dharma_forge_proving_ground
+_10_10_readiness_goal.md). ``--json`` prints the report; ``--strict`` exits
+non-zero unless the score is a full 10/10. The grader is read-only and makes no
+claim beyond what the run artifacts independently support.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from dataclasses import asdict, dataclass, field
+from pathlib import Path
+
+if __package__ in (None, ""):
+    sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+from scripts.runtime.forge_proving_ground_common import (  # noqa: E402
+    DEFAULT_FRESHNESS_WINDOW_S,
+    EXTERNALITY_LEVELS,
+    FORBIDDEN_ACTIONS,
+    LEASE_REQUIRED_LEVELS,
+    PROVING_GROUND_ROOT,
+    parse_iso,
+    read_json,
+    sha256_file,
+)
+from scripts.runtime.forge_proving_ground_run import latest_run_dir
+
+COMPONENT_FILES = (
+    "forge_proving_ground_common.py",
+    "forge_provider_oracle.py",
+    "forge_real_benchmark_adapter.py",
+    "forge_proving_ground_autoresearch.py",
+    "forge_proving_ground_patch_sandbox.py",
+    "forge_proving_ground_verifier.py",
+    "forge_proving_ground_run.py",
+    "forge_proving_ground_readiness.py",
+)
+
+TEST_FILES = (
+    "test_forge_proving_ground_readiness.py",
+    "test_forge_proving_ground_run.py",
+    "test_forge_provider_oracle.py",
+    "test_forge_real_benchmark_adapter.py",
+    "test_forge_proving_ground_autoresearch.py",
+    "test_forge_proving_ground_patch_sandbox.py",
+    "test_forge_proving_ground_verifier.py",
+)
+
+RUN_RECEIPTS = (
+    "provider_proof.json",
+    "benchmark_proof.json",
+    "autoresearch_proposal.json",
+    "patch_sandbox_result.json",
+    "authority_attestation.json",
+    "run_summary.json",
+    "run_manifest.json",
+    "verifier_verdict.json",
+)
+
+MAX_SCORE = 10
+
+
+@dataclass
+class Criterion:
+    id: str
+    ok: bool
+    detail: str = ""
+
+    def to_dict(self) -> dict:
+        return asdict(self)
+
+
+@dataclass
+class ReadinessReport:
+    schema: str
+    readiness_score: int
+    max_score: int
+    ready: bool
+    custody_label: str
+    run_dir: str | None
+    criteria: list[Criterion] = field(default_factory=list)
+
+    def to_dict(self) -> dict:
+        data = asdict(self)
+        data["criteria"] = [c.to_dict() if isinstance(c, Criterion) else c for c in self.criteria]
+        return data
+
+
+def _safe(fn) -> tuple[bool, str]:
+    try:
+        return fn()
+    except Exception as exc:  # noqa: BLE001 - any failure fails the criterion honestly
+        return False, f"{type(exc).__name__}: {exc}"
+
+
+def evaluate_readiness(
+    *,
+    repo_root: Path = Path("."),
+    out_root: Path = PROVING_GROUND_ROOT,
+    freshness_window_s: int = DEFAULT_FRESHNESS_WINDOW_S,
+) -> ReadinessReport:
+    repo_root = Path(repo_root)
+    runtime_dir = repo_root / "scripts" / "runtime"
+    tests_dir = repo_root / "tests"
+    run_dir = latest_run_dir(out_root if Path(out_root).is_absolute() else repo_root / out_root)
+
+    criteria: list[Criterion] = []
+
+    # 1. components_present
+    def c1() -> tuple[bool, str]:
+        missing = [n for n in COMPONENT_FILES if not (runtime_dir / n).exists()]
+        if missing:
+            return False, f"missing: {missing}"
+        for n in COMPONENT_FILES:
+            src = (runtime_dir / n).read_text(encoding="utf-8")
+            compile(src, str(runtime_dir / n), "exec")
+        return True, f"{len(COMPONENT_FILES)} components present and compile"
+
+    criteria.append(Criterion("components_present", *_safe(c1)))
+
+    # 2. tests_present
+    def c2() -> tuple[bool, str]:
+        missing = [n for n in TEST_FILES if not (tests_dir / n).exists()]
+        if missing:
+            return False, f"missing: {missing}"
+        empty = [n for n in TEST_FILES if "def test" not in (tests_dir / n).read_text(encoding="utf-8")]
+        if empty:
+            return False, f"no test functions in: {empty}"
+        return True, f"{len(TEST_FILES)} test files present with test functions"
+
+    criteria.append(Criterion("tests_present", *_safe(c2)))
+
+    # 3. latest_run_present
+    def c3() -> tuple[bool, str]:
+        if run_dir is None:
+            return False, "no fpg-* run dir found"
+        missing = [n for n in RUN_RECEIPTS if not (run_dir / n).exists()]
+        if missing:
+            return False, f"missing receipts: {missing}"
+        return True, f"latest run {run_dir.name} has all receipts"
+
+    criteria.append(Criterion("latest_run_present", *_safe(c3)))
+
+    # 4. provider_proof_fresh
+    def c4() -> tuple[bool, str]:
+        proof = read_json(run_dir / "provider_proof.json")
+        manifest = read_json(run_dir / "run_manifest.json")
+        if proof.get("status") != "ok":
+            return False, f"status={proof.get('status')}"
+        if not proof.get("custody_label"):
+            return False, "missing custody_label"
+        if not proof.get("fresh"):
+            return False, "probe not fresh"
+        age = abs((parse_iso(proof["generated_at"]) - parse_iso(manifest["generated_at"])).total_seconds())
+        if age > freshness_window_s:
+            return False, f"provider proof stale relative to run: age={age}s"
+        return True, "provider proof fresh and bound to this run"
+
+    criteria.append(Criterion("provider_proof_fresh", *_safe(c4)))
+
+    # 5. benchmark_proof_strength
+    def c5() -> tuple[bool, str]:
+        bench = read_json(run_dir / "benchmark_proof.json")
+        authority = read_json(run_dir / "authority_attestation.json")
+        level = bench.get("externality_level")
+        if level not in EXTERNALITY_LEVELS:
+            return False, f"bad externality level: {level}"
+        cmd = (bench.get("baseline_evidence") or {}).get("command")
+        if not cmd:
+            return False, "no real baseline execution command"
+        if bench.get("externality_proof_strength") != "real_local_execution":
+            return False, "benchmark not really executed"
+        if level in LEASE_REQUIRED_LEVELS and not authority.get("lease"):
+            return False, f"externality {level} overclaimed without lease"
+        return True, f"externality={level} (honest), baseline executed"
+
+    criteria.append(Criterion("benchmark_proof_strength", *_safe(c5)))
+
+    # 6. autoresearch_bounded
+    def c6() -> tuple[bool, str]:
+        prop = read_json(run_dir / "autoresearch_proposal.json")
+        cands = prop.get("candidates") or []
+        if not cands:
+            return False, "no candidates"
+        for c in cands:
+            if not c.get("files") or not c.get("rationale"):
+                return False, "candidate missing files/rationale"
+        bounds = prop.get("bounds_attestation") or {}
+        if not bounds.get("no_external_calls"):
+            return False, "external calls not ruled out"
+        if bounds.get("max_candidates", 0) < 1 or bounds.get("candidates_emitted", 0) > bounds.get("max_candidates", 0):
+            return False, "bounds violated"
+        return True, f"{len(cands)} bounded candidate(s), no external calls"
+
+    criteria.append(Criterion("autoresearch_bounded", *_safe(c6)))
+
+    # 7. keep_revert_proof
+    def c7() -> tuple[bool, str]:
+        sb = read_json(run_dir / "patch_sandbox_result.json")
+        before, after = sb.get("before_score"), sb.get("after_score")
+        decision = sb.get("decision")
+        if before is None or after is None:
+            return False, "missing scores"
+        if decision not in ("keep", "revert"):
+            return False, f"bad decision: {decision}"
+        delta = after - before
+        consistent = (decision == "keep" and delta > 0) or (decision == "revert" and delta <= 0)
+        if not consistent:
+            return False, f"decision {decision} inconsistent with delta {delta}"
+        for ev_key in ("before_evidence", "after_evidence"):
+            ev = sb.get(ev_key) or {}
+            if not ev.get("command") or "returncode" not in ev:
+                return False, f"{ev_key} lacks real evidence"
+        att = sb.get("protected_path_attestation") or {}
+        if att.get("touched_protected_path") is not False or att.get("real_repo_mutated") is not False:
+            return False, "protected-path attestation not clean"
+        return True, f"before={before} after={after} decision={decision} (proven)"
+
+    criteria.append(Criterion("keep_revert_proof", *_safe(c7)))
+
+    # 8. verifier_independent_pass
+    def c8() -> tuple[bool, str]:
+        v = read_json(run_dir / "verifier_verdict.json")
+        if v.get("verdict") != "PASS":
+            return False, f"verdict={v.get('verdict')}"
+        if not v.get("agreement"):
+            return False, "verifier did not agree with run scores"
+        ind = v.get("independence_attestation") or {}
+        if not ind.get("verifier_reran_benchmark_subprocess"):
+            return False, "verifier did not re-run benchmark"
+        return True, "independent verifier PASS, recomputed scores agree"
+
+    criteria.append(Criterion("verifier_independent_pass", *_safe(c8)))
+
+    # 9. authority_boundary_hygiene
+    def c9() -> tuple[bool, str]:
+        a = read_json(run_dir / "authority_attestation.json")
+        actions = a.get("forbidden_actions") or {}
+        not_taken = [n for n in FORBIDDEN_ACTIONS if actions.get(n) != "not_taken"]
+        if not_taken:
+            return False, f"not attested not_taken: {not_taken}"
+        if a.get("offline") is not True or a.get("network_calls") != 0:
+            return False, "offline/network attestation failed"
+        return True, "all forbidden actions not_taken, offline"
+
+    criteria.append(Criterion("authority_boundary_hygiene", *_safe(c9)))
+
+    # 10. id_chain_and_no_overclaim
+    def c10() -> tuple[bool, str]:
+        manifest = read_json(run_dir / "run_manifest.json")
+        summary = read_json(run_dir / "run_summary.json")
+        ident = manifest.get("identity") or {}
+        if not ident.get("run_id") or not ident.get("trace_id"):
+            return False, "manifest missing canonical identity"
+        for entry in manifest.get("receipts", []):
+            target = run_dir / entry["path"]
+            if not target.exists():
+                return False, f"manifest receipt missing: {entry['path']}"
+            if sha256_file(target) != entry.get("sha256"):
+                return False, f"hash mismatch: {entry['path']}"
+        if (summary.get("identity") or {}).get("run_id") != ident.get("run_id"):
+            return False, "summary/manifest run_id mismatch"
+        claims = summary.get("claims") or {}
+        overclaims = [k for k, val in claims.items() if val is True]
+        if overclaims:
+            return False, f"overclaim detected: {overclaims}"
+        if not summary.get("custody_label"):
+            return False, "summary missing custody label"
+        return True, "id chain consistent, hashes match, no overclaim"
+
+    criteria.append(Criterion("id_chain_and_no_overclaim", *_safe(c10)))
+
+    score = sum(1 for c in criteria if c.ok)
+    return ReadinessReport(
+        schema="forge_proving_ground_readiness.v1",
+        readiness_score=score,
+        max_score=MAX_SCORE,
+        ready=score == MAX_SCORE,
+        custody_label="dry_run_only",
+        run_dir=str(run_dir) if run_dir else None,
+        criteria=criteria,
+    )
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--repo-root", type=Path, default=Path("."))
+    parser.add_argument("--out-root", type=Path, default=PROVING_GROUND_ROOT)
+    parser.add_argument("--json", action="store_true")
+    parser.add_argument("--strict", action="store_true")
+    return parser
+
+
+def main(argv: list[str] | None = None) -> int:
+    args = build_parser().parse_args(argv)
+    report = evaluate_readiness(repo_root=args.repo_root, out_root=args.out_root)
+    payload = report.to_dict()
+    print(json.dumps(payload, indent=2, sort_keys=True))
+    if args.strict and not report.ready:
+        return 5
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
