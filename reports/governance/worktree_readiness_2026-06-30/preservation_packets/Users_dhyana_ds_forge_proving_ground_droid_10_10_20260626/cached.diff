@@ -0,0 +1,58 @@
+"""Tests for the proving-ground readiness grader."""
+
+from pathlib import Path
+
+from scripts.runtime.forge_proving_ground_readiness import MAX_SCORE, evaluate_readiness
+from scripts.runtime.forge_proving_ground_run import run_proving_ground
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+
+
+def _criterion(report, cid):
+    return next(c for c in report.criteria if c.id == cid)
+
+
+def test_full_score_on_fresh_run(tmp_path):
+    run = run_proving_ground(out_root=tmp_path / "runs")
+    report = evaluate_readiness(repo_root=REPO_ROOT, out_root=run.run_dir.parent)
+    assert report.max_score == MAX_SCORE
+    assert report.readiness_score == MAX_SCORE
+    assert report.ready is True
+    assert all(c.ok for c in report.criteria)
+
+
+def test_missing_run_is_not_ready(tmp_path):
+    report = evaluate_readiness(repo_root=REPO_ROOT, out_root=tmp_path / "empty")
+    assert report.ready is False
+    assert _criterion(report, "latest_run_present").ok is False
+
+
+def test_tampered_receipt_breaks_id_chain(tmp_path):
+    run = run_proving_ground(out_root=tmp_path / "runs")
+    summary_path = run.run_dir / "run_summary.json"
+    summary_path.write_text(summary_path.read_text() + "\n# tamper\n")
+    report = evaluate_readiness(repo_root=REPO_ROOT, out_root=run.run_dir.parent)
+    assert report.ready is False
+    assert _criterion(report, "id_chain_and_no_overclaim").ok is False
+
+
+def test_overclaim_detected(tmp_path):
+    import json
+
+    run = run_proving_ground(out_root=tmp_path / "runs")
+    summary_path = run.run_dir / "run_summary.json"
+    summary = json.loads(summary_path.read_text())
+    summary["claims"]["sota_complete"] = True
+    # Re-seal so hashes still match the manifest, isolating the overclaim check.
+    from scripts.runtime.forge_proving_ground_common import sha256_file, write_json
+
+    write_json(summary_path, summary)
+    manifest_path = run.run_dir / "run_manifest.json"
+    manifest = json.loads(manifest_path.read_text())
+    for entry in manifest["receipts"]:
+        if entry["path"] == "run_summary.json":
+            entry["sha256"] = sha256_file(summary_path)
+    write_json(manifest_path, manifest)
+
+    report = evaluate_readiness(repo_root=REPO_ROOT, out_root=run.run_dir.parent)
+    assert _criterion(report, "id_chain_and_no_overclaim").ok is False
