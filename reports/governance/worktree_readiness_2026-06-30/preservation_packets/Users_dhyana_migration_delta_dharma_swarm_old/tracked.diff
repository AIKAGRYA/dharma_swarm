+def adapt_ingestion(base_path: Path | None = None) -> AdapterResult:
+    """Read semantic/ingestion_spine.db documents into KnowledgeArtifact objects."""
+
+    import sqlite3
+
+    base = base_path or _DEFAULT_BASE
+    db_path = base / "semantic" / "ingestion_spine.db"
+    if not db_path.exists():
+        return []
+
+    results: AdapterResult = []
+    try:
+        conn = sqlite3.connect(str(db_path))
+        conn.row_factory = sqlite3.Row
+        rows = conn.execute(
+            """
+            SELECT doc_id, source_name, source_path, title, summary, concepts_json, claims_json
+            FROM documents
+            ORDER BY updated_at DESC, doc_id ASC
+            """
+        )
+        for row in rows:
+            try:
+                doc_id = str(row["doc_id"] or "")
+                if not doc_id:
+                    continue
+                title = str(row["title"] or "").strip()
+                summary = str(row["summary"] or "").strip()
+                if not title and not summary:
+                    logger.debug("adapt_ingestion: skipping empty document %s", doc_id)
+                    continue
+
+                # Parse JSON fields so corrupt rows are rejected early.
+                json.loads(row["concepts_json"] or "[]")
+                json.loads(row["claims_json"] or "[]")
+
+                source_path = str(row["source_path"] or "")
+                props: dict[str, Any] = {
+                    "title": title or Path(source_path).name or doc_id,
+                    "artifact_type": "file" if source_path.startswith("/") else "note",
+                    "domain": "dharma_swarm",
+                    "content": summary,
+                    "file_path": source_path,
+                    "provenance": str(row["source_name"] or ""),
+                    "confidence": 0.5,
+                    "verified": False,
+                }
+                results.append((_make_obj(f"ingest_{doc_id}", "KnowledgeArtifact", props), []))
+            except Exception as exc:
+                logger.warning("adapt_ingestion: skipping record %s: %s", row["doc_id"], exc)
+        conn.close()
+    except Exception as exc:
+        logger.warning("adapt_ingestion: %s", exc)
+    return results
+
+
+def _claim_payload_from_entry(entry: Any, *, source_path: str) -> dict[str, Any] | None:
+    if isinstance(entry, str):
+        text = entry.strip()
+        if not text:
+            return None
+        return {
+            "claim_text": text,
+            "status": "proposed",
+            "confidence": 0.5,
+            "evidence": "",
+            "source_path": source_path,
+        }
+
+    if isinstance(entry, dict):
+        text = str(entry.get("text") or entry.get("claim") or entry.get("statement") or "").strip()
+        if not text:
+            return None
+        status = str(entry.get("status") or "proposed")
+        if status not in {"proposed", "accepted", "deprecated", "rejected"}:
+            status = "proposed"
+        evidence = entry.get("evidence", "")
+        if evidence and not isinstance(evidence, str):
+            evidence = json.dumps(evidence, default=str)
+        return {
+            "claim_text": text,
+            "status": status,
+            "confidence": float(entry.get("confidence", 0.5)),
+            "evidence": str(evidence or ""),
+            "source_path": source_path,
+        }
+
+    return None
+
+
+def adapt_claims(base_path: Path | None = None) -> AdapterResult:
+    """Read claims_json from semantic/ingestion_spine.db into CorpusClaim objects."""
+
+    import sqlite3
+
+    base = base_path or _DEFAULT_BASE
+    db_path = base / "semantic" / "ingestion_spine.db"
+    if not db_path.exists():
+        return []
+
+    results: AdapterResult = []
+    try:
+        conn = sqlite3.connect(str(db_path))
+        conn.row_factory = sqlite3.Row
+        rows = conn.execute(
+            """
+            SELECT doc_id, source_path, claims_json
+            FROM documents
+            ORDER BY updated_at DESC, doc_id ASC
+            """
+        )
+        for row in rows:
+            doc_id = str(row["doc_id"] or "")
+            source_path = str(row["source_path"] or "")
+            try:
+                claims = json.loads(row["claims_json"] or "[]")
+            except json.JSONDecodeError as exc:
+                logger.warning("adapt_claims: skipping record %s: %s", doc_id, exc)
+                continue
+
+            if not isinstance(claims, list):
+                logger.warning("adapt_claims: skipping non-list claims for %s", doc_id)
+                continue
+
+            for idx, entry in enumerate(claims):
+                payload = _claim_payload_from_entry(entry, source_path=source_path)
+                if payload is None:
+                    continue
+                obj_id = f"iclaim_{doc_id}_{idx}"
+                links = [
+                    _make_link(
+                        "source_artifact",
+                        obj_id,
+                        "CorpusClaim",
+                        f"ingest_{doc_id}",
+                        "KnowledgeArtifact",
+                    )
+                ]
+                results.append((_make_obj(obj_id, "CorpusClaim", payload), links))
+        conn.close()
+    except Exception as exc:
+        logger.warning("adapt_claims: %s", exc)
+    return results
+
