+def _pid_file_status(path: Path) -> tuple[int | None, str]:
+    """Return the pid plus a coarse liveness status for a pid file."""
+    if not path.exists():
+        return None, "missing"
+    try:
+        pid = int(path.read_text(encoding="utf-8").strip())
+    except Exception:
+        return None, "invalid"
+
+    return pid, _pid_status(pid)
+
+
+def _pid_status(pid: int | None) -> str:
+    """Return a coarse liveness status for a pid value."""
+    if pid is None:
+        return "missing"
+    try:
+        if int(pid) <= 1:
+            return "stale"
+        os.kill(int(pid), 0)
+    except (TypeError, ValueError, OSError):
+        return "stale"
+    return "alive"
+
+
+def _command_for_pid(pid: int | None) -> str | None:
+    """Return the process command line for a pid, if available."""
+    if pid is None:
+        return None
+    ps_bin = os.environ.get("PS_BIN", "ps").strip() or "ps"
+    try:
+        completed = subprocess.run(
+            [ps_bin, "-p", str(pid), "-o", "command="],
+            capture_output=True,
+            check=False,
+            text=True,
+            timeout=2,
+        )
+    except (OSError, ValueError, subprocess.SubprocessError):
+        return None
+
+    for raw_line in completed.stdout.splitlines():
+        command = raw_line.strip()
+        if command:
+            return command
+    return None
+
+
