+    import subprocess
+    from dharma_swarm import dgc_cli as cli
+
+    dharma_state = tmp_path / ".dharma"
+    live_timestamp = (datetime.now(timezone.utc) - timedelta(seconds=10)).isoformat()
+    live_runner_log = dharma_state / "logs" / "pulse.log"
+    live_runner_log.parent.mkdir(parents=True)
+    live_runner_log.write_text(
+        f"\n--- PULSE @ {live_timestamp} [swarm:phenomenological] ---\n"
+        "runtime=swarm tick=1 status=starting\n",
+        encoding="utf-8",
+    )
+
+    cron_dir = dharma_state / "cron"
+    cron_dir.mkdir(parents=True)
+    skewed_ts = datetime.now(timezone.utc) + timedelta(hours=12)
+    skewed = cron_dir / f"pulse_{skewed_ts.strftime('%Y%m%d_%H%M%S')}.md"
+    skewed.write_text("pulse ok", encoding="utf-8")
+    skewed.touch()
+
+    monkeypatch.setattr(cli, "HOME", tmp_path)
+    monkeypatch.setattr(cli, "DHARMA_STATE", dharma_state)
+    monkeypatch.setattr(cli, "DGC_CORE", tmp_path / "dgc-core")
+
+    def _fake_run(coro):
+        coro.close()
+        return 0
+
+    monkeypatch.setattr(cli, "_run", _fake_run)
