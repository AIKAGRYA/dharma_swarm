+        cli.subprocess,
+        "run",
+        lambda *args, **kwargs: subprocess.CompletedProcess(args[0], 0, "2.1.87 (Claude Code)\n", ""),
+    )
+
+    pulse_count, last_pulse, pulse_source = cli._canonical_pulse_summary()
+    cli.cmd_status()
+
+    out = capsys.readouterr().out
+    assert pulse_count == 1
+    assert last_pulse is not None
+    assert pulse_source == live_runner_log
+    assert "logs/pulse.log" in out
