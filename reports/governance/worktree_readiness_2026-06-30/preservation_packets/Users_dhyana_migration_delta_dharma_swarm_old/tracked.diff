+def _capability_names(objects: list[OntologyObj]) -> set[str]:
+    return {
+        str(obj.properties.get("name") or obj.id)
+        for obj in objects
+    }
+
+
+def match_capabilities(
+    registry: OntologyRegistry,
+    task_id: str,
+    agent_id: str,
+) -> dict[str, Any]:
+    """Compare one agent's capabilities against a task's requirements."""
+
+    required = _capability_names(registry.get_linked_objects(task_id, "requires_capability"))
+    possessed = _capability_names(registry.get_linked_objects(agent_id, "has_capability"))
+    matched = sorted(required & possessed)
+    missing = sorted(required - possessed)
+    extra = sorted(possessed - required)
+    score = 1.0 if not required else len(matched) / len(required)
+    return {
+        "agent_id": agent_id,
+        "score": score,
+        "matched": matched,
+        "missing": missing,
+        "extra": extra,
+    }
+
+
+def rank_agents_for_task(
+    registry: OntologyRegistry,
+    task_id: str,
+) -> list[dict[str, Any]]:
+    """Rank registered agents by capability fit for a task."""
+
+    ranked = [
+        match_capabilities(registry, task_id, agent.id)
+        for agent in registry.get_objects_by_type("AgentIdentity")
+    ]
+    return sorted(
+        ranked,
+        key=lambda item: (-item["score"], -len(item["matched"]), item["agent_id"]),
+    )
+
