{
  "$id": "https://dharma.local/schemas/dharma_verifier_ranker_output_v0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claim_integrity_risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "type": "number"
    },
    "evidence_sufficiency": {
      "maximum": 1.0,
      "minimum": 0.0,
      "type": "number"
    },
    "gate_failures": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "missing_evidence": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "next_required_action": {
      "minLength": 1,
      "type": "string"
    },
    "privacy_risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "quality_score": {
      "maximum": 1.0,
      "minimum": 0.0,
      "type": "number"
    },
    "rationale_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "route_risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "verdict": {
      "enum": [
        "approve",
        "revise",
        "block",
        "escalate",
        "insufficient_context"
      ]
    }
  },
  "required": [
    "verdict",
    "quality_score",
    "evidence_sufficiency",
    "claim_integrity_risk",
    "privacy_risk",
    "route_risk",
    "gate_failures",
    "missing_evidence",
    "next_required_action",
    "confidence",
    "rationale_refs"
  ],
  "title": "DharmaVerifier-Ranker v0 Output",
  "type": "object"
}
